#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM="${0##*/}"
VERSION="0.4.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCRIPT_PATH="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}"
SYSTEM_PROMPT_FILE="${GLM_SYSTEM_PROMPT_FILE:-$SCRIPT_DIR/system-prompt.md}"
ROLE_PROMPTS_DIR="${GLM_ROLE_PROMPTS_DIR:-$SCRIPT_DIR/prompts}"
DEFAULT_ROLE="${GLM_ROLE:-general-purpose}"

GLM_AGENT_HOME="${GLM_AGENT_HOME:-$HOME/.glm}"
if [[ "$GLM_AGENT_HOME" != /* ]]; then
  GLM_AGENT_HOME="$PWD/$GLM_AGENT_HOME"
fi

AUTH_FILE="$GLM_AGENT_HOME/.env.auth"
WORKERS_DIR="$GLM_AGENT_HOME/workers"

ZAI_BASE_URL="${ZAI_BASE_URL:-https://api.z.ai/api/anthropic}"
ZAI_HAIKU_MODEL="${ZAI_HAIKU_MODEL:-glm-5.3-flash[1m]}"
ZAI_SONNET_MODEL="${ZAI_SONNET_MODEL:-glm-5.3[1m]}"
ZAI_OPUS_MODEL="${ZAI_OPUS_MODEL:-glm-5.3[1m]}"
CLAUDE_MODEL="${CLAUDE_MODEL:-sonnet}"

usage() {
  cat <<'EOF'
glm-agent - persistent GLM coding worker for agent orchestration

USAGE
  glm-agent api-key [key]
  glm-agent run <prompt>
  glm-agent start [--role <role>] [--model <alias>] [--cwd <directory>] <task>
  glm-agent start --async [--role <role>] [--model <alias>] [--cwd <directory>] <task>
  glm-agent send <worker-id> <message>
  glm-agent send --async <worker-id> <message>
  glm-agent wait [--timeout <seconds>] <worker-id>
  glm-agent cancel <worker-id>
  glm-agent tui [--role <role>] [--model <alias>] [--cwd <directory>]
  glm-agent tui <worker-id>
  glm-agent result <worker-id>
  glm-agent status <worker-id>
  glm-agent list
  glm-agent close <worker-id>
  glm-agent --help
  glm-agent --version

DESCRIPTION
  glm-agent runs GLM through Claude Code using Z.ai's Anthropic-compatible
  endpoint. A worker is durable across invocations: start creates a Claude
  session and send resumes that same session in its original directory with
  its original role and model. tui opens that same managed session in native
  Claude Code. --async returns worker identity before provider completion.

  stdout is compact and machine-readable. Detailed reports, raw Claude JSON,
  and stderr are stored under ~/.glm/workers/<worker-id>/.

COMMANDS
  api-key [key]
      Save the Z.ai API key. With no argument, read it from an interactive
      hidden prompt so it does not enter shell history. The stored key takes
      second priority to an explicit ZAI_API_KEY environment variable.

  run <prompt>
      Run a one-shot diagnostic GLM Claude Code session. This does not create
      a persistent worker and prints Claude's normal response.

  start [--role <role>] [--model <alias>] [--cwd <directory>] <task>
      Create a worker and execute its first turn. Roles are explorer and
      general-purpose. Defaults are role=general-purpose, model=sonnet, and
      cwd=current directory.

      Output:
        WORKER_ID=<id>
        TURN=1
        MODEL=opus|sonnet|haiku
        ROLE=explorer|general-purpose
        STATUS=DONE|BLOCKED|INVALID
        RESULT=<absolute-path>
        ERROR_KIND=<classification-or-empty>
        PROVIDER_CODE=<Z.ai-code-or-empty>
        FALLBACK_RECOMMENDED=true|false

  start --async [--role <role>] [--model <alias>] [--cwd <directory>] <task>
      Create the same persistent worker, detach its first headless turn, and
      return STATUS=RUNNING with its worker ID and expected result path.

  send <worker-id> <message>
      Execute another turn by resuming the stored Claude session. send always
      uses the worker's original cwd, role, and model.

  send --async <worker-id> <message>
      Resume the stored session in a detached turn and return its RUNNING
      receipt immediately.

  wait [--timeout <seconds>] <worker-id>
      Observe a worker for up to 20 seconds by default (0..300). A terminal
      result returns WAIT_RESULT=TERMINAL. A bounded timeout returns
      WAIT_RESULT=TIMEOUT while the worker continues.

  cancel <worker-id>
      Stop an active asynchronous headless turn, including provider processes
      in its managed process group. Partial artifacts remain and the turn is
      classified INVALID/interrupted.

  tui [--role <role>] [--model <alias>] [--cwd <directory>]
      Create a managed worker and open its Z.ai-backed native Claude Code TUI.

  tui <worker-id>
      Open the worker's stored Claude session in its original cwd, role, and
      model. Creation options are invalid when attaching.

  result <worker-id>
      Print the absolute path to the latest valid durable result file.

  status <worker-id>
      Print worker status without invoking Claude or exposing its session ID.

  list
      List known workers and their current status.

  close <worker-id>
      Mark an idle worker closed. This does not delete its history. A closed
      worker remains available to result and status but rejects send and tui.

WORKER FILES
  ~/.glm/workers/<worker-id>/
    meta
    task.md
    turns/NNNN/
      prompt.md
      response.json
      stderr.log
      result.md
      runner.log      # asynchronous headless turns
      exit.meta       # TUI batches

STATUS VALUES
  DONE      The worker produced a valid result ending in STATUS: DONE.
  BLOCKED   The worker produced a valid result ending in STATUS: BLOCKED.
  INVALID   Claude failed, returned malformed data, or violated the result
            protocol. Raw response and stderr files remain available.
  RUNNING   A turn is currently executing or was interrupted externally.
  NEW       A worker exists but no turn has begun.

WORKER CONTRACT
  Every turn receives an absolute GLM_RESULT_FILE path. The worker must do and
  verify the requested work, write the full report to that file, read it back,
  and make its final line exactly STATUS: DONE or STATUS: BLOCKED. Starting a
  background process alone is not completion. The wrapper classifies missing
  or malformed results and invocation failures as INVALID.

  RUNNING is a launch receipt, not task completion.
  Stopping a parent Claude turn leaves a detached worker running.
  Use cancel with its recorded worker ID when the GLM task itself should stop.

ORCHESTRATOR WORKFLOW
  1. glm-agent start --async "<task>"
  2. Record WORKER_ID, then use wait or status until terminal.
  3. Read RESULT and inspect the actual changes.
  4. glm-agent send --async <worker-id> "<review feedback>" when needed.
  5. Use cancel to stop active work, or close after all turns are finished.

ENVIRONMENT
  GLM_SYSTEM_PROMPT_FILE
      System prompt Markdown read at the start of every worker turn.
      Default: system-prompt.md next to the glm-agent executable.

  GLM_ROLE_PROMPTS_DIR
      Directory containing explorer.md and general-purpose.md, read directly
      on every turn. Default: prompts/ next to the executable.

SECURITY
  ~/.glm is mode 0700 and ~/.glm/.env.auth is mode 0600. The API key is never
  printed by glm-agent. Worker status output omits the Claude session ID.

  start and send use Claude Code's --dangerously-skip-permissions mode so a
  headless worker can edit files and run verification without an interactive
  approval prompt. Start workers only in repositories you trust.

EXIT STATUS
  0  Command succeeded; DONE and BLOCKED are both successful worker turns.
  1  Claude invocation or worker result protocol failed (STATUS=INVALID).
  2  Invalid CLI usage, configuration, dependency, or worker state.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

require_command() {
  local command_name="$1"
  command -v "$command_name" >/dev/null 2>&1 ||
    die "required command not found: $command_name"
}

validate_single_line() {
  local label="$1"
  local value="$2"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] ||
    die "$label must be a single line"
}

validate_worker_id() {
  local worker_id="$1"
  [[ "$worker_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid worker id: $worker_id"
}

validate_role() {
  case "$1" in
    explorer|general-purpose) return 0 ;;
    *) die "invalid role: $1" ;;
  esac
}

role_prompt_file() {
  printf '%s/%s.md\n' "$ROLE_PROMPTS_DIR" "$1"
}

ensure_state_home() {
  mkdir -p "$GLM_AGENT_HOME"
  chmod 700 "$GLM_AGENT_HOME"
}

load_api_key() {
  if [[ -n "${ZAI_API_KEY:-}" ]]; then
    return 0
  fi

  [[ -f "$AUTH_FILE" ]] ||
    die "API key is not configured. Run: $PROGRAM api-key"

  ZAI_API_KEY="$(<"$AUTH_FILE")"
  [[ -n "$ZAI_API_KEY" ]] || die "stored API key is empty"
}

require_execution_dependencies() {
  require_command claude
  require_command jq
}

require_system_prompt_file() {
  [[ -f "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file not found: $SYSTEM_PROMPT_FILE"
  [[ -r "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file is not readable: $SYSTEM_PROMPT_FILE"
  [[ -s "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file is empty: $SYSTEM_PROMPT_FILE"
}

run_glm_claude() {
  require_command claude

  env \
    -u CLAUDECODE \
    ANTHROPIC_BASE_URL="$ZAI_BASE_URL" \
    ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$ZAI_HAIKU_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$ZAI_SONNET_MODEL" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$ZAI_OPUS_MODEL" \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    API_TIMEOUT_MS=3000000 \
    claude "$@"
}

new_worker_id() {
  printf '%s-%s-%s\n' \
    "$(date -u +%Y%m%dT%H%M%SZ)" \
    "$$" \
    "${RANDOM:-0}"
}

new_claude_session_id() {
  local hex

  hex="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$hex" =~ ^[0-9a-f]{32}$ ]] || die "failed to allocate Claude session id"
  hex="${hex:0:12}4${hex:13:3}8${hex:17}"
  printf '%s-%s-%s-%s-%s\n' \
    "${hex:0:8}" "${hex:8:4}" "${hex:12:4}" "${hex:16:4}" "${hex:20:12}"
}

worker_dir() {
  printf '%s/%s\n' "$WORKERS_DIR" "$1"
}

meta_get() {
  local dir="$1"
  local key="$2"
  sed -n "s/^${key}=//p" "$dir/meta" | head -n 1
}

meta_set() {
  local dir="$1"
  local key="$2"
  local value="$3"
  local tmp

  validate_single_line "metadata value for $key" "$value"
  tmp="$(mktemp "$dir/.meta.XXXXXX")"
  chmod 600 "$tmp"
  grep -v "^${key}=" "$dir/meta" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  mv "$tmp" "$dir/meta"
}

active_get() {
  local dir="$1"
  local key="$2"
  local state_file="$dir/active/state"

  [[ -f "$state_file" ]] || return 0
  sed -n "s/^${key}=//p" "$state_file" | head -n 1
}

active_set() {
  local dir="$1"
  local key="$2"
  local value="$3"
  local state_file="$dir/active/state"
  local tmp

  [[ -d "$dir/active" && -f "$state_file" ]] ||
    die "worker has no active lock: $(meta_get "$dir" worker_id)"
  validate_single_line "active metadata value for $key" "$value"
  tmp="$(mktemp "$dir/active/.state.XXXXXX")"
  chmod 600 "$tmp"
  grep -v "^${key}=" "$state_file" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  mv "$tmp" "$state_file"
}

acquire_worker_lock() {
  local dir="$1"
  local mode="$2"
  local active_dir="$dir/active"

  if ! mkdir "$active_dir" 2>/dev/null; then
    die "worker is active: $(meta_get "$dir" worker_id)"
  fi
  chmod 700 "$active_dir"
  (
    umask 077
    cat >"$active_dir/state" <<EOF
mode=$mode
turn=
supervision=
runner_pid=
provider_pgid=
started_at=$(date +%s)
EOF
  )
}

release_worker_lock() {
  local dir="$1"
  local active_dir="$dir/active"

  [[ -d "$active_dir" ]] || return 0
  rm -f "$active_dir/state" "$active_dir/cancel.requested" \
    "$active_dir/launch.ready"
  rmdir "$active_dir" 2>/dev/null || true
}

process_is_alive() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

process_group_is_alive() {
  local pgid="$1"
  [[ "$pgid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 -- "-$pgid" 2>/dev/null
}

turn_result_path() {
  local dir="$1"
  local turn="$2"
  local turn_label

  printf -v turn_label '%04d' "$turn"
  printf '%s/turns/%s/result.md\n' "$dir" "$turn_label"
}

finalize_interrupted_turn() {
  local dir="$1"

  meta_set "$dir" status "INVALID"
  meta_set "$dir" error_kind "interrupted"
  meta_set "$dir" provider_code ""
  release_worker_lock "$dir"
}

recover_stale_lock() {
  local dir="$1"
  local runner_pid

  [[ -d "$dir/active" ]] || return 0
  runner_pid="$(active_get "$dir" runner_pid)"
  [[ -n "$runner_pid" ]] || return 0
  if ! process_is_alive "$runner_pid"; then
    finalize_interrupted_turn "$dir"
  fi
}

require_worker() {
  local worker_id="$1"
  local dir

  validate_worker_id "$worker_id"
  dir="$(worker_dir "$worker_id")"
  [[ -f "$dir/meta" ]] || die "worker not found: $worker_id"
}

print_turn_control() {
  local dir="$1"
  local turn="$2"
  local status="$3"
  local result_file="$4"
  local error_kind="$5"
  local provider_code="$6"

  printf 'WORKER_ID=%s\n' "$(meta_get "$dir" worker_id)"
  printf 'TURN=%s\n' "$turn"
  printf 'MODEL=%s\n' "$(meta_get "$dir" model)"
  printf 'ROLE=%s\n' "$(meta_get "$dir" role)"
  printf 'STATUS=%s\n' "$status"
  printf 'RESULT=%s\n' "$result_file"
  printf 'ERROR_KIND=%s\n' "$error_kind"
  printf 'PROVIDER_CODE=%s\n' "$provider_code"
  if [[ "$error_kind" == "quota-exhausted" ]]; then
    printf '%s\n' 'FALLBACK_RECOMMENDED=true'
  else
    printf '%s\n' 'FALLBACK_RECOMMENDED=false'
  fi
}

extract_zai_code() {
  local response_file="$1"
  local stderr_file="$2"
  local code=""

  code="$(
    { cat "$response_file"; cat "$stderr_file"; } 2>/dev/null |
      grep -Eo '"code"[[:space:]]*:[[:space:]]*"?[0-9]+' |
      sed -E 's/[^0-9]*([0-9]+).*/\1/' |
      head -n 1
  )" || true
  printf '%s\n' "$code"
}

classify_error_kind() {
  local provider_code="$1"
  local default_kind="$2"

  case "$provider_code" in
    1113|1308|1310|1316|1317|1318|1319|1320|1321)
      printf '%s\n' 'quota-exhausted'
      ;;
    1302|1305) printf '%s\n' 'provider-transient' ;;
    1000|1001|1003) printf '%s\n' 'authentication' ;;
    1211|1311) printf '%s\n' 'model-unavailable' ;;
    '') printf '%s\n' "$default_kind" ;;
    *) printf '%s\n' 'provider-error' ;;
  esac
}

invalidate_turn() {
  local dir="$1"
  local turn="$2"
  local result_file="$3"
  local error="$4"
  local error_kind="$5"
  local provider_code="$6"

  meta_set "$dir" status "INVALID"
  meta_set "$dir" error_kind "$error_kind"
  meta_set "$dir" provider_code "$provider_code"
  release_worker_lock "$dir"
  print_turn_control "$dir" "$turn" "INVALID" "$result_file" \
    "$error_kind" "$provider_code"
  printf 'ERROR=%s\n' "$error"
  return 1
}

validate_worker_execution() {
  local worker_id="$1"
  local dir
  local model
  local cwd
  local current_turn
  local role
  local role_prompt_path

  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  model="$(meta_get "$dir" model)"
  role="$(meta_get "$dir" role)"
  cwd="$(meta_get "$dir" cwd)"
  current_turn="$(meta_get "$dir" turn)"

  [[ -n "$model" ]] || die "worker has no model: $worker_id"
  validate_role "$role"
  [[ -n "$cwd" ]] || die "worker has no working directory: $worker_id"
  [[ -d "$cwd" ]] || die "worker working directory does not exist: $cwd"
  [[ "$current_turn" =~ ^[0-9]+$ ]] ||
    die "worker has invalid turn metadata: $worker_id"
  require_system_prompt_file
  role_prompt_path="$(role_prompt_file "$role")"
  [[ -r "$role_prompt_path" && -s "$role_prompt_path" ]] ||
    die "role prompt file is missing, unreadable, or empty: $role_prompt_path"
}

build_turn_system_prompt() {
  local role="$1"
  local result_file="$2"
  local role_prompt_path
  local system_prompt
  local role_prompt

  role_prompt_path="$(role_prompt_file "$role")"
  system_prompt="$(<"$SYSTEM_PROMPT_FILE")"
  role_prompt="$(<"$role_prompt_path")"
  system_prompt+=$'\n\n<worker_role>\n'
  system_prompt+="$role_prompt"
  system_prompt+=$'\n</worker_role>'
  system_prompt+=$'\n\n<current_turn_result_file>\n'
  system_prompt+="For this turn, GLM_RESULT_FILE is exactly this absolute path:"
  system_prompt+=$'\n'
  system_prompt+="$result_file"
  system_prompt+=$'\nWrite the report to that exact path, then read it back as required.\n</current_turn_result_file>'
  printf '%s\n' "$system_prompt"
}

prepare_turn() {
  local worker_id="$1"
  local prompt="$2"
  local mode="$3"
  local dir
  local current_turn
  local turn
  local turn_label
  local turn_dir

  dir="$(worker_dir "$worker_id")"
  acquire_worker_lock "$dir" "$mode"
  current_turn="$(meta_get "$dir" turn)"
  turn="$((10#$current_turn + 1))"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"

  if ! mkdir "$turn_dir"; then
    release_worker_lock "$dir"
    die "turn already exists: $worker_id/$turn_label"
  fi
  chmod 700 "$turn_dir"
  printf '%s\n' "$mode" >"$turn_dir/mode"
  printf '%s\n' "$prompt" >"$turn_dir/prompt.md"
  chmod 600 "$turn_dir/mode" "$turn_dir/prompt.md"

  active_set "$dir" turn "$turn"
  meta_set "$dir" turn "$turn"
  meta_set "$dir" status "RUNNING"
  meta_set "$dir" error_kind ""
  meta_set "$dir" provider_code ""
  printf '%s\n' "$turn"
}

execute_headless_turn() {
  local worker_id="$1"
  local turn="$2"
  local dir
  local model
  local cwd
  local session_id
  local turn_label
  local turn_dir
  local prompt
  local response_file
  local stderr_file
  local result_file
  local exit_code=0
  local returned_session_id
  local result_status
  local provider_code
  local error_kind
  local error_label
  local system_prompt
  local role
  local role_prompt_path
  local role_prompt
  local provider_pid
  local provider_pgid
  local -a args

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"

  dir="$(worker_dir "$worker_id")"
  [[ "$(active_get "$dir" mode)" == "headless" &&
     "$(active_get "$dir" turn)" == "$turn" ]] ||
    die "worker active turn does not match: $worker_id/$turn"
  model="$(meta_get "$dir" model)"
  role="$(meta_get "$dir" role)"
  cwd="$(meta_get "$dir" cwd)"
  session_id="$(meta_get "$dir" claude_session_id)"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  prompt="$(<"$turn_dir/prompt.md")"
  response_file="$turn_dir/response.json"
  stderr_file="$turn_dir/stderr.log"
  result_file="$turn_dir/result.md"
  validate_single_line "result file path" "$result_file"

  system_prompt="$(build_turn_system_prompt "$role" "$result_file")"

  args=(
    -p
    --model "$model"
    --output-format json
    --dangerously-skip-permissions
    --append-system-prompt "$system_prompt"
  )
  if [[ -n "$session_id" ]]; then
    args+=(--resume "$session_id")
  fi

  if [[ -f "$dir/active/cancel.requested" ]]; then
    : >"$response_file"
    : >"$stderr_file"
    chmod 600 "$response_file" "$stderr_file"
    invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
      "interrupted" ""
    return 1
  fi

  set -m
  (
    cd "$cwd"
    GLM_RESULT_FILE="$result_file" run_glm_claude "${args[@]}" "$prompt"
  ) >"$response_file" 2>"$stderr_file" &
  provider_pid=$!
  provider_pgid="$(ps -o pgid= -p "$provider_pid" | tr -d ' ')"
  if [[ ! "$provider_pgid" =~ ^[1-9][0-9]*$ ]]; then
    kill "$provider_pid" 2>/dev/null || true
    wait "$provider_pid" 2>/dev/null || true
    set +m
    invalidate_turn "$dir" "$turn" "$result_file" \
      "provider-process-group-missing" "invocation" ""
    return 1
  fi
  active_set "$dir" provider_pgid "$provider_pgid"
  if [[ -f "$dir/active/cancel.requested" ]]; then
    kill -TERM -- "-$provider_pgid" 2>/dev/null || true
  fi
  if wait "$provider_pid"; then
    exit_code=0
  else
    exit_code=$?
  fi
  set +m

  chmod 600 "$response_file" "$stderr_file"

  if [[ -f "$dir/active/cancel.requested" ]]; then
    invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
      "interrupted" ""
    return 1
  fi

  provider_code="$(extract_zai_code "$response_file" "$stderr_file")"
  if ((exit_code != 0)) ||
     jq -e 'type == "object" and .is_error == true' \
       "$response_file" >/dev/null 2>&1; then
    if ((exit_code != 0)); then
      error_label="claude-exit-$exit_code"
      error_kind="$(classify_error_kind "$provider_code" "invocation")"
    else
      error_label="claude-error-response"
      error_kind="$(classify_error_kind "$provider_code" "provider-error")"
    fi
    invalidate_turn "$dir" "$turn" "$result_file" "$error_label" \
      "$error_kind" "$provider_code"
    return 1
  fi

  if ! returned_session_id="$(
    jq -er '
      select(type == "object" and (.is_error != true))
      | .session_id
      | select(type == "string" and length > 0)
    ' "$response_file" 2>/dev/null
  )"; then
    invalidate_turn "$dir" "$turn" "$result_file" "invalid-response" \
      "worker-protocol" ""
    return 1
  fi

  if [[ -n "$session_id" && "$returned_session_id" != "$session_id" ]]; then
    invalidate_turn "$dir" "$turn" "$result_file" "unexpected-session-id" \
      "worker-protocol" ""
    return 1
  fi

  if [[ -z "$session_id" ]]; then
    meta_set "$dir" claude_session_id "$returned_session_id"
  fi

  if [[ ! -s "$result_file" ]]; then
    invalidate_turn "$dir" "$turn" "$result_file" "result-file-missing" \
      "worker-protocol" ""
    return 1
  fi
  chmod 600 "$result_file"

  case "$(tail -n 1 "$result_file")" in
    'STATUS: DONE')
      result_status="DONE"
      ;;
    'STATUS: BLOCKED')
      result_status="BLOCKED"
      ;;
    *)
      invalidate_turn "$dir" "$turn" "$result_file" "result-status-invalid" \
        "worker-protocol" ""
      return 1
      ;;
  esac

  meta_set "$dir" status "$result_status"
  meta_set "$dir" latest_result "$result_file"
  meta_set "$dir" error_kind ""
  meta_set "$dir" provider_code ""
  release_worker_lock "$dir"
  print_turn_control "$dir" "$turn" "$result_status" "$result_file" "" ""
}

run_turn() {
  local worker_id="$1"
  local prompt="$2"
  local turn

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"
  turn="$(prepare_turn "$worker_id" "$prompt" "headless")"
  active_set "$(worker_dir "$worker_id")" supervision "sync"
  active_set "$(worker_dir "$worker_id")" runner_pid "$$"
  execute_headless_turn "$worker_id" "$turn"
}

launch_async_turn() {
  local worker_id="$1"
  local turn="$2"
  local dir
  local turn_label
  local turn_dir
  local result_file
  local runner_pid

  dir="$(worker_dir "$worker_id")"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  result_file="$turn_dir/result.md"

  set -m
  nohup "$SCRIPT_PATH" _execute-turn "$worker_id" "$turn" \
    </dev/null >"$turn_dir/runner.log" 2>&1 &
  runner_pid=$!
  set +m
  chmod 600 "$turn_dir/runner.log"
  active_set "$dir" supervision "async"
  active_set "$dir" runner_pid "$runner_pid"
  print_turn_control "$dir" "$turn" "RUNNING" "$result_file" "" ""
  : >"$dir/active/launch.ready"
  chmod 600 "$dir/active/launch.ready"
}

run_turn_async() {
  local worker_id="$1"
  local prompt="$2"
  local turn

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"
  turn="$(prepare_turn "$worker_id" "$prompt" "headless")"
  launch_async_turn "$worker_id" "$turn"
}

cmd_execute_turn() {
  (($# == 2)) || die "_execute-turn requires a worker-id and turn"

  local worker_id="$1"
  local turn="$2"
  local dir
  local result_file
  local turn_label
  local turn_dir
  local ready=false

  validate_worker_id "$worker_id"
  [[ "$turn" =~ ^[1-9][0-9]*$ ]] || die "invalid turn: $turn"
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  result_file="$turn_dir/result.md"

  for _ in {1..500}; do
    if [[ -f "$dir/active/cancel.requested" ]]; then
      : >"$turn_dir/response.json"
      : >"$turn_dir/stderr.log"
      chmod 600 "$turn_dir/response.json" "$turn_dir/stderr.log"
      invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
        "interrupted" ""
      return 1
    fi
    if [[ -f "$dir/active/launch.ready" ]]; then
      ready=true
      break
    fi
    sleep 0.01
  done
  if [[ "$ready" != "true" ]]; then
    finalize_interrupted_turn "$dir"
    die "async launch handshake timed out: $worker_id/$turn"
  fi
  [[ "$(active_get "$dir" runner_pid)" == "$$" ]] ||
    die "async runner identity does not match: $worker_id/$turn"
  [[ "$(active_get "$dir" turn)" == "$turn" ]] ||
    die "async runner turn does not match: $worker_id/$turn"

  execute_headless_turn "$worker_id" "$turn"
}

print_observed_turn() {
  local dir="$1"
  local status="$2"
  local turn
  local result_file

  turn="$(meta_get "$dir" turn)"
  result_file="$(turn_result_path "$dir" "$turn")"
  print_turn_control "$dir" "$turn" "$status" "$result_file" \
    "$(meta_get "$dir" error_kind)" "$(meta_get "$dir" provider_code)"
}

create_worker() {
  local model="$1"
  local role="$2"
  local cwd="$3"
  local task="$4"
  local session_id="${5:-}"
  local worker_id
  local dir

  ensure_state_home
  mkdir -p "$WORKERS_DIR"
  chmod 700 "$WORKERS_DIR"
  worker_id="$(new_worker_id)"
  dir="$(worker_dir "$worker_id")"
  mkdir "$dir"
  chmod 700 "$dir"
  mkdir "$dir/turns"
  chmod 700 "$dir/turns"

  (
    umask 077
    cat >"$dir/meta" <<EOF
worker_id=$worker_id
claude_session_id=$session_id
model=$model
role=$role
cwd=$cwd
turn=0
status=NEW
closed=false
latest_result=
error_kind=
provider_code=
EOF
    printf '%s\n' "$task" >"$dir/task.md"
  )
  printf '%s\n' "$worker_id"
}

runner_identity_matches() {
  local dir="$1"
  local runner_pid
  local worker_id
  local turn
  local command_line

  runner_pid="$(active_get "$dir" runner_pid)"
  worker_id="$(meta_get "$dir" worker_id)"
  turn="$(active_get "$dir" turn)"
  process_is_alive "$runner_pid" || return 1
  command_line="$(ps -o command= -p "$runner_pid" 2>/dev/null || true)"
  [[ "$command_line" == *"_execute-turn $worker_id $turn"* ]]
}

valid_provider_group() {
  local dir="$1"
  local pgid
  local actual_pgid
  local own_pgid

  pgid="$(active_get "$dir" provider_pgid)"
  [[ "$pgid" =~ ^[1-9][0-9]*$ ]] || return 1
  own_pgid="$(ps -o pgid= -p "$$" | tr -d ' ')"
  [[ "$pgid" != "$own_pgid" ]] || return 1
  actual_pgid="$(ps -o pgid= -p "$pgid" 2>/dev/null | tr -d ' ')"
  [[ "$actual_pgid" == "$pgid" ]]
}

signal_provider_group() {
  local dir="$1"
  local signal="$2"
  local pgid

  valid_provider_group "$dir" || return 1
  pgid="$(active_get "$dir" provider_pgid)"
  kill "-$signal" -- "-$pgid" 2>/dev/null
}

cmd_api_key() {
  (($# <= 1)) || die "api-key accepts at most one argument"

  local key="${1:-}"
  if [[ -z "$key" ]]; then
    [[ -t 0 ]] || die "api-key requires a key when stdin is not interactive"
    printf 'Z.ai API key: ' >&2
    IFS= read -r -s key
    printf '\n' >&2
  fi
  [[ -n "$key" ]] || die "API key must not be empty"

  ensure_state_home
  local tmp
  tmp="$(mktemp "$GLM_AGENT_HOME/.env.auth.XXXXXX")"
  chmod 600 "$tmp"
  printf '%s' "$key" >"$tmp"
  mv "$tmp" "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"

  printf 'API_KEY=SAVED\n'
  printf 'AUTH_FILE=%s\n' "$AUTH_FILE"
}

cmd_run() {
  (($# > 0)) || die "run requires a prompt"
  load_api_key
  local prompt="$*"
  (
    unset GLM_RESULT_FILE
    run_glm_claude -p --model "$CLAUDE_MODEL" "$prompt"
  )
}

cmd_start() {
  local model="$CLAUDE_MODEL"
  local role="$DEFAULT_ROLE"
  local cwd="$PWD"
  local async=false

  while (($#)); do
    case "$1" in
      --async)
        async=true
        shift
        ;;
      --model)
        (($# >= 2)) || die "--model requires a value"
        model="$2"
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --cwd)
        (($# >= 2)) || die "--cwd requires a value"
        cwd="$2"
        shift 2
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --*)
        die "unknown option for start: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  (($# > 0)) || die "start requires a task"
  local task="$*"

  validate_single_line "model" "$model"
  [[ -n "$model" ]] || die "model must not be empty"
  validate_single_line "role" "$role"
  validate_role "$role"
  [[ -d "$cwd" ]] || die "working directory does not exist: $cwd"
  cwd="$(cd "$cwd" && pwd -P)"
  validate_single_line "working directory" "$cwd"

  require_execution_dependencies
  load_api_key
  require_system_prompt_file
  local worker_id
  worker_id="$(create_worker "$model" "$role" "$cwd" "$task" "")"

  if [[ "$async" == "true" ]]; then
    run_turn_async "$worker_id" "$task"
  else
    run_turn "$worker_id" "$task"
  fi
}

run_tui_batch() {
  local worker_id="$1"
  local session_mode="$2"
  local dir
  local turn
  local turn_label
  local turn_dir
  local result_file
  local stderr_file
  local exit_meta
  local model
  local role
  local cwd
  local session_id
  local system_prompt
  local started_at
  local exit_code=0
  local result_status
  local provider_code
  local error_kind
  local -a args

  validate_worker_execution "$worker_id"
  dir="$(worker_dir "$worker_id")"
  model="$(meta_get "$dir" model)"
  role="$(meta_get "$dir" role)"
  cwd="$(meta_get "$dir" cwd)"
  session_id="$(meta_get "$dir" claude_session_id)"
  [[ -n "$session_id" ]] || die "worker has no Claude session: $worker_id"

  turn="$(prepare_turn "$worker_id" "Managed Claude Code TUI batch" "tui")"
  active_set "$dir" supervision "tui"
  active_set "$dir" runner_pid "$$"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  result_file="$turn_dir/result.md"
  stderr_file="$turn_dir/stderr.log"
  exit_meta="$turn_dir/exit.meta"
  system_prompt="$(build_turn_system_prompt "$role" "$result_file")"

  args=(
    --model "$model"
    --dangerously-skip-permissions
    --append-system-prompt "$system_prompt"
  )
  if [[ "$session_mode" == "new" ]]; then
    args+=(--session-id "$session_id")
  else
    args+=(--resume "$session_id")
  fi

  print_turn_control "$dir" "$turn" "RUNNING" "$result_file" "" ""
  printf 'CWD=%s\n' "$cwd"
  started_at="$(date +%s)"
  (
    cd "$cwd"
    GLM_RESULT_FILE="$result_file" run_glm_claude "${args[@]}"
  ) 2>"$stderr_file" || exit_code=$?
  chmod 600 "$stderr_file"
  (
    umask 077
    cat >"$exit_meta" <<EOF
started_at=$started_at
ended_at=$(date +%s)
exit_code=$exit_code
EOF
  )

  if ((exit_code != 0)); then
    provider_code="$(extract_zai_code /dev/null "$stderr_file")"
    error_kind="$(classify_error_kind "$provider_code" "invocation")"
    invalidate_turn "$dir" "$turn" "$result_file" "claude-exit-$exit_code" \
      "$error_kind" "$provider_code"
    return 1
  fi
  if [[ ! -s "$result_file" ]]; then
    invalidate_turn "$dir" "$turn" "$result_file" "result-file-missing" \
      "worker-protocol" ""
    return 1
  fi
  chmod 600 "$result_file"
  case "$(tail -n 1 "$result_file")" in
    'STATUS: DONE') result_status="DONE" ;;
    'STATUS: BLOCKED') result_status="BLOCKED" ;;
    *)
      invalidate_turn "$dir" "$turn" "$result_file" \
        "result-status-invalid" "worker-protocol" ""
      return 1
      ;;
  esac

  meta_set "$dir" status "$result_status"
  meta_set "$dir" latest_result "$result_file"
  meta_set "$dir" error_kind ""
  meta_set "$dir" provider_code ""
  release_worker_lock "$dir"
  print_turn_control "$dir" "$turn" "$result_status" "$result_file" "" ""
}

cmd_tui() {
  local model="$CLAUDE_MODEL"
  local role="$DEFAULT_ROLE"
  local cwd="$PWD"
  local creation_option=false

  while (($#)); do
    case "$1" in
      --model)
        (($# >= 2)) || die "--model requires a value"
        model="$2"
        creation_option=true
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        creation_option=true
        shift 2
        ;;
      --cwd)
        (($# >= 2)) || die "--cwd requires a value"
        cwd="$2"
        creation_option=true
        shift 2
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --*) die "unknown option for tui: $1" ;;
      *) break ;;
    esac
  done
  (($# <= 1)) || die "tui accepts at most one worker-id"

  require_execution_dependencies
  load_api_key
  require_system_prompt_file
  if (($# == 1)); then
    [[ "$creation_option" == "false" ]] ||
      die "TUI creation options cannot be used with an existing worker"
    local worker_id="$1"
    local dir
    require_worker "$worker_id"
    dir="$(worker_dir "$worker_id")"
    recover_stale_lock "$dir"
    [[ "$(meta_get "$dir" closed)" != "true" ]] ||
      die "worker is closed: $worker_id"
    [[ ! -d "$dir/active" ]] || die "worker is active: $worker_id"
    [[ -n "$(meta_get "$dir" claude_session_id)" ]] ||
      die "worker has no Claude session: $worker_id"
    run_tui_batch "$worker_id" "resume"
    return
  fi

  validate_single_line "model" "$model"
  [[ -n "$model" ]] || die "model must not be empty"
  validate_single_line "role" "$role"
  validate_role "$role"
  [[ -d "$cwd" ]] || die "working directory does not exist: $cwd"
  cwd="$(cd "$cwd" && pwd -P)"
  validate_single_line "working directory" "$cwd"
  require_command od

  local session_id
  local worker_id
  session_id="$(new_claude_session_id)"
  worker_id="$(create_worker "$model" "$role" "$cwd" \
    "Managed Claude Code TUI worker" "$session_id")"
  run_tui_batch "$worker_id" "new"
}

cmd_send() {
  local async=false
  if [[ "${1:-}" == "--async" ]]; then
    async=true
    shift
  fi
  (($# >= 2)) || die "send requires a worker-id and message"

  local worker_id="$1"
  shift
  local message="$*"
  local dir

  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  [[ "$(meta_get "$dir" closed)" != "true" ]] ||
    die "worker is closed: $worker_id"
  [[ -n "$(meta_get "$dir" claude_session_id)" ]] ||
    die "worker has no Claude session: $worker_id"

  if [[ "$async" == "true" ]]; then
    run_turn_async "$worker_id" "$message"
  else
    run_turn "$worker_id" "$message"
  fi
}

cmd_wait() {
  local timeout=20

  while (($#)); do
    case "$1" in
      --timeout)
        (($# >= 2)) || die "--timeout requires a value"
        timeout="$2"
        shift 2
        ;;
      --*) die "unknown option for wait: $1" ;;
      *) break ;;
    esac
  done
  (($# == 1)) || die "wait requires a worker-id"
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "wait timeout must be an integer from 0 to 300"
  ((10#$timeout <= 300)) || die "wait timeout must be an integer from 0 to 300"

  local worker_id="$1"
  local dir
  local status
  local deadline
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  deadline="$(( $(date +%s) + 10#$timeout ))"

  while :; do
    recover_stale_lock "$dir"
    status="$(meta_get "$dir" status)"
    case "$status" in
      DONE|BLOCKED|INVALID)
        print_observed_turn "$dir" "$status"
        printf '%s\n' 'WAIT_RESULT=TERMINAL'
        return 0
        ;;
    esac
    if (( $(date +%s) >= deadline )); then
      print_observed_turn "$dir" "$status"
      printf '%s\n' 'WAIT_RESULT=TIMEOUT'
      return 0
    fi
    sleep 0.1
  done
}

cmd_cancel() {
  (($# == 1)) || die "cancel requires a worker-id"

  local worker_id="$1"
  local dir
  local status
  local runner_pid
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"

  if [[ ! -d "$dir/active" ]]; then
    status="$(meta_get "$dir" status)"
    case "$status" in
      DONE|BLOCKED|INVALID)
        print_observed_turn "$dir" "$status"
        printf '%s\n' 'CANCEL_RESULT=ALREADY_TERMINAL'
        return 0
        ;;
      *) die "worker has no active asynchronous turn: $worker_id" ;;
    esac
  fi

  [[ "$(active_get "$dir" mode)" == "headless" &&
     "$(active_get "$dir" supervision)" == "async" ]] ||
    die "worker is not running an asynchronous headless turn: $worker_id"
  runner_identity_matches "$dir" ||
    die "active runner identity is invalid: $worker_id"

  : >"$dir/active/cancel.requested"
  chmod 600 "$dir/active/cancel.requested"
  signal_provider_group "$dir" TERM || true

  for _ in {1..50}; do
    [[ ! -d "$dir/active" ]] && break
    sleep 0.1
  done

  if [[ -d "$dir/active" ]]; then
    runner_pid="$(active_get "$dir" runner_pid)"
    if runner_identity_matches "$dir"; then
      kill -TERM "$runner_pid" 2>/dev/null || true
    fi
    for _ in {1..10}; do
      [[ ! -d "$dir/active" ]] && break
      sleep 0.1
    done
  fi

  if [[ -d "$dir/active" ]]; then
    signal_provider_group "$dir" KILL || true
    runner_pid="$(active_get "$dir" runner_pid)"
    if runner_identity_matches "$dir"; then
      kill -KILL "$runner_pid" 2>/dev/null || true
    fi
    finalize_interrupted_turn "$dir"
  fi

  status="$(meta_get "$dir" status)"
  print_observed_turn "$dir" "$status"
  printf '%s\n' 'CANCEL_RESULT=CANCELLED'
}

cmd_result() {
  (($# == 1)) || die "result requires a worker-id"

  local worker_id="$1"
  local dir
  local result
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  result="$(meta_get "$dir" latest_result)"
  [[ -n "$result" && -f "$result" ]] ||
    die "worker has no valid result: $worker_id"
  printf '%s\n' "$result"
}

cmd_status() {
  (($# == 1)) || die "status requires a worker-id"

  local worker_id="$1"
  local dir
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"

  printf 'WORKER_ID=%s\n' "$worker_id"
  printf 'STATUS=%s\n' "$(meta_get "$dir" status)"
  printf 'TURN=%s\n' "$(meta_get "$dir" turn)"
  printf 'MODEL=%s\n' "$(meta_get "$dir" model)"
  printf 'ROLE=%s\n' "$(meta_get "$dir" role)"
  printf 'CWD=%s\n' "$(meta_get "$dir" cwd)"
  printf 'CLOSED=%s\n' "$(meta_get "$dir" closed)"
  printf 'RESULT=%s\n' "$(meta_get "$dir" latest_result)"
  printf 'ERROR_KIND=%s\n' "$(meta_get "$dir" error_kind)"
  printf 'PROVIDER_CODE=%s\n' "$(meta_get "$dir" provider_code)"
  if [[ "$(meta_get "$dir" error_kind)" == "quota-exhausted" ]]; then
    printf '%s\n' 'FALLBACK_RECOMMENDED=true'
  else
    printf '%s\n' 'FALLBACK_RECOMMENDED=false'
  fi
  printf 'ACTIVE_MODE=%s\n' "$(active_get "$dir" mode)"
  printf 'ACTIVE_TURN=%s\n' "$(active_get "$dir" turn)"
}

cmd_list() {
  (($# == 0)) || die "list accepts no arguments"
  [[ -d "$WORKERS_DIR" ]] || return 0

  local dir
  for dir in "$WORKERS_DIR"/*; do
    [[ -f "$dir/meta" ]] || continue
    printf 'WORKER_ID=%s\tSTATUS=%s\tTURN=%s\tROLE=%s\tCLOSED=%s\tCWD=%s\n' \
      "$(meta_get "$dir" worker_id)" \
      "$(meta_get "$dir" status)" \
      "$(meta_get "$dir" turn)" \
      "$(meta_get "$dir" role)" \
      "$(meta_get "$dir" closed)" \
      "$(meta_get "$dir" cwd)"
  done
}

cmd_close() {
  (($# == 1)) || die "close requires a worker-id"

  local worker_id="$1"
  local dir
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"
  [[ ! -d "$dir/active" ]] || die "worker is active: $worker_id"
  meta_set "$dir" closed "true"

  printf 'WORKER_ID=%s\n' "$worker_id"
  printf 'CLOSED=true\n'
}

main() {
  local command="${1:-}"

  case "$command" in
    --help|-h|help|"")
      usage
      ;;
    --version|version)
      printf '%s %s\n' "$PROGRAM" "$VERSION"
      ;;
    api-key)
      shift
      cmd_api_key "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    send)
      shift
      cmd_send "$@"
      ;;
    tui)
      shift
      cmd_tui "$@"
      ;;
    wait)
      shift
      cmd_wait "$@"
      ;;
    cancel)
      shift
      cmd_cancel "$@"
      ;;
    result)
      shift
      cmd_result "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    close)
      shift
      cmd_close "$@"
      ;;
    _execute-turn)
      shift
      cmd_execute_turn "$@"
      ;;
    *)
      die "unknown command: $command (try '$PROGRAM --help')"
      ;;
  esac
}

main "$@"
