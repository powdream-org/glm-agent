#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM="${0##*/}"
VERSION="1.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCRIPT_PATH="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}"
SYSTEM_PROMPT_FILE="${GLM_SYSTEM_PROMPT_FILE:-$SCRIPT_DIR/system-prompt.md}"
ROLE_PROMPTS_DIR="${GLM_ROLE_PROMPTS_DIR:-$SCRIPT_DIR/prompts}"
DEFAULT_ROLE="${GLM_ROLE:-general-purpose}"

GLM_AGENT_HOME="${GLM_AGENT_HOME:-$HOME/.glm}"
if [[ "$GLM_AGENT_HOME" != /* ]]; then
  GLM_AGENT_HOME="$PWD/$GLM_AGENT_HOME"
fi

AUTH_FILE="$GLM_AGENT_HOME/.env.auth"
TEAM_SCOPE_FILE="$GLM_AGENT_HOME/.env.team-scope"
WORKERS_DIR="$GLM_AGENT_HOME/workers"
CLEANUP_STAMP_FILE="$GLM_AGENT_HOME/.cleanup-stamp"
CLEANUP_LOG_FILE="$GLM_AGENT_HOME/cleanup.log"

ZAI_BASE_URL="${ZAI_BASE_URL:-https://api.z.ai/api/anthropic}"
ZAI_HAIKU_MODEL="${ZAI_HAIKU_MODEL:-glm-5.3-flash[1m]}"
ZAI_SONNET_MODEL="${ZAI_SONNET_MODEL:-glm-5.3-flash[1m]}"
ZAI_OPUS_MODEL="${ZAI_OPUS_MODEL:-glm-5.3[1m]}"
CLAUDE_MODEL="${CLAUDE_MODEL:-sonnet}"

usage() {
  cat <<'EOF'
glm-agent - persistent GLM coding worker for agent orchestration

USAGE
  glm-agent api-key [key]
  glm-agent team-scope [<organization> <project> | --clear]
  glm-agent run <prompt>
  glm-agent start [--role <role>] [--model <alias>] [--cwd <directory>] <task>
  glm-agent start --async [--role <role>] [--model <alias>] [--cwd <directory>] <task>
  glm-agent send <worker-id> <message>
  glm-agent send --async <worker-id> <message>
  glm-agent wait [--timeout <seconds>] <worker-id>
  glm-agent cancel <worker-id>
  glm-agent tui [--model <alias>] [--cwd <directory>] [--resume <session-id>]
  glm-agent result <worker-id>
  glm-agent status <worker-id>
  glm-agent list
  glm-agent close <worker-id>
  glm-agent quota
  glm-agent --help
  glm-agent --version

DESCRIPTION
  glm-agent runs GLM through Claude Code using Z.ai's Anthropic-compatible
  endpoint. A worker is durable across invocations: start creates a Claude
  session and send resumes that same session in its original directory with
  its original role and model. tui opens a plain interactive Claude Code
  session with no worker framing. --async returns worker identity before
  provider completion.

  stdout is compact and machine-readable. Detailed reports, raw Claude JSON,
  and stderr are stored under ~/.glm/workers/<worker-id>/.

COMMANDS
  api-key [key]
      Save the Z.ai API key. With no argument, read it from an interactive
      hidden prompt so it does not enter shell history. The stored file is
      the only key source; the ZAI_API_KEY environment variable is never
      read.

  team-scope [<organization> <project> | --clear]
      Show, save, or clear the team-plan quota scope. quota queries the
      personal coding plan by default; a saved organization and project
      switch it to the team plan (type=2 with Bigmodel selector headers).
      The ZAI_QUOTA_ORGANIZATION and ZAI_QUOTA_PROJECT environment
      variables override the stored values one by one. Configuring exactly
      one selector is a configuration error; quota needs both or neither.

  run <prompt>
      Run a one-shot diagnostic GLM Claude Code session. This does not create
      a persistent worker and prints Claude's normal response.

  start [--role <role>] [--model <alias>] [--cwd <directory>] <task>
      Create a worker and execute its first turn. Roles are explorer and
      general-purpose. Defaults are role=general-purpose, model=sonnet, and
      cwd=current directory.

      Output:
        WORKER_ID=<id>
        TURN=1
        MODEL=opus|sonnet|haiku
        ROLE=explorer|general-purpose
        STATUS=DONE|BLOCKED|NO_REPORT|INVALID
        RESULT=<absolute-path>
        ERROR_KIND=<classification-or-empty>
        PROVIDER_CODE=<Z.ai-code-or-empty>
        FALLBACK_RECOMMENDED=true|false

      With STATUS=NO_REPORT, the output also carries REASON, REPLY, and NEXT
      before FALLBACK_RECOMMENDED.

  start --async [--role <role>] [--model <alias>] [--cwd <directory>] <task>
      Create the same persistent worker, detach its first headless turn, and
      return STATUS=RUNNING with its worker ID and expected result path.

  send <worker-id> <message>
      Execute another turn by resuming the stored Claude session. send always
      uses the worker's original cwd, role, and model.

  send --async <worker-id> <message>
      Resume the stored session in a detached turn and return its RUNNING
      receipt immediately.

  wait [--timeout <seconds>] <worker-id>
      Observe a worker for up to 20 seconds by default (0..300). A terminal
      result returns WAIT_RESULT=TERMINAL. A bounded timeout returns
      WAIT_RESULT=TIMEOUT while the worker continues.

  cancel <worker-id>
      Stop an active asynchronous headless turn, including provider processes
      in its managed process group. Partial artifacts remain and the turn is
      classified INVALID/interrupted. CANCEL_RESULT=CANCELLED or
      ALREADY_TERMINAL means the reported STATUS is final. CANCEL_RESULT=PENDING
      means the worker has not yet settled (another party is finalizing it, or
      a replacement turn already started) — treat it like WAIT_RESULT=TIMEOUT
      and retry cancel or wait.

  tui [--model <alias>] [--cwd <directory>] [--resume <session-id>]
      Open a plain interactive Z.ai-backed Claude Code session. This is the
      User's own main session: no worker is created, no worker contract
      system prompt or result file is injected, and the session interacts
      with the terminal directly. A new session prints its SESSION_ID so it
      can be reopened later with --resume. Claude Code itself has no
      session-name resume; use the printed session id.

  result <worker-id>
      Print the absolute path to the latest valid durable result file.

  status <worker-id>
      Print worker status without invoking Claude or exposing its session ID.

  list
      List known workers and their current status.

  close <worker-id>
      Mark an idle worker closed. This does not delete its history. A closed
      worker remains available to result and status but rejects send.

    quota
        Query Z.ai's monitor API once and print the credit quota per window.
        This creates no worker and starts no Claude session. Values are
        printed as the server reports them; the glm-agent:quota skill turns
        them into a dispatch decision. The last raw response and curl stderr
        are kept in ~/.glm/quota/response.json and ~/.glm/quota/stderr.log.
        Requires curl 7.55 or newer and jq.

        Output:
          QUOTA_STATUS=OK|INVALID
          SCOPE=personal|team
          PLAN_LEVEL=<plan-or-empty>
          LIMIT_COUNT=<n>
          LIMIT_<i>_TYPE=<server-type>
          LIMIT_<i>_WINDOW=<n>h|<n>w|u<unit>x<number>|<empty>
          LIMIT_<i>_TOTAL=<credits-or-empty>
          LIMIT_<i>_USED=<credits-or-empty>
          LIMIT_<i>_REMAINING=<credits-or-empty>
          LIMIT_<i>_USED_PERCENT=<percent-or-empty>
          LIMIT_<i>_RESET_AT=<UTC-timestamp-or-empty>
          RESPONSE=<absolute-path>
          ERROR_KIND=<classification-or-empty>
          PROVIDER_CODE=<Z.ai-code-or-empty>

        The LIMIT_<i>_ lines appear once per limit, only when
        QUOTA_STATUS=OK. A failed lookup prints only QUOTA_STATUS=INVALID,
        SCOPE, RESPONSE, ERROR_KIND, and PROVIDER_CODE. ERROR_KIND is one of
        authentication, quota-exhausted, provider-transient,
        model-unavailable, provider-error, or invalid-response.

WORKER FILES
  ~/.glm/workers/<worker-id>/
    meta
    task.md
    turns/NNNN/
      prompt.md
      response.json
      stderr.log
      result.md
      runner.log      # asynchronous headless turns
      exit.meta       # TUI batches

STATUS VALUES
  DONE      The worker produced a valid result ending in STATUS: DONE.
  BLOCKED   The worker produced a valid result ending in STATUS: BLOCKED.
  NO_REPORT The turn ended without a valid result file. The work may be done.
            This is not an error: do not close the worker or resend the task.
            Read REPLY, check the changed files, and judge.
  INVALID   Claude failed or returned malformed data. Raw response and stderr
            files remain available.
  RUNNING   A turn is currently executing or was interrupted externally.
  NEW       A worker exists but no turn has begun.

WORKER CONTRACT
  Every turn receives an absolute GLM_RESULT_FILE path. The worker must do and
  verify the requested work, write the full report to that file, read it back,
  and make its final line exactly STATUS: DONE or STATUS: BLOCKED. Starting a
  background process alone is not completion. The wrapper classifies a missing
  or malformed result as NO_REPORT and an invocation failure as INVALID.

  RUNNING is a launch receipt, not task completion.
  Stopping a parent Claude turn leaves a detached worker running.
  Use cancel with its recorded worker ID when the GLM task itself should stop.

ORCHESTRATOR WORKFLOW
  1. glm-agent start --async "<task>"
  2. Record WORKER_ID, then use wait or status until terminal.
  3. Read RESULT, or REPLY when STATUS=NO_REPORT, and inspect the actual changes.
  4. glm-agent send --async <worker-id> "<review feedback>" when needed.
  5. Use cancel to stop active work, or close after all turns are finished.

ENVIRONMENT
  GLM_SYSTEM_PROMPT_FILE
      System prompt Markdown read at the start of every worker turn.
      Default: system-prompt.md next to the glm-agent executable.

  ZAI_QUOTA_ORGANIZATION, ZAI_QUOTA_PROJECT
      Team-plan quota selectors for quota, overriding the stored
      team-scope values one by one. Both or neither must be set.

  GLM_ROLE_PROMPTS_DIR
      Directory containing explorer.md and general-purpose.md, read directly
      on every turn. Default: prompts/ next to the executable.

  GLM_WORKER_RETENTION_DAYS
      Days a finished worker is kept after its last activity. start deletes
      older DONE, BLOCKED, NO_REPORT, and INVALID workers at most once per 24
      hours. Default: 21. 0 turns the cleanup off.

SECURITY
  ~/.glm is mode 0700 and ~/.glm/.env.auth is mode 0600. The API key is never
  printed by glm-agent. Worker status output omits the Claude session ID.

  start and send use Claude Code's --dangerously-skip-permissions mode so a
  headless worker can edit files and run verification without an interactive
  approval prompt. Start workers only in repositories you trust.

  quota sends the API key to Z.ai only as an HTTP header that curl reads from
  stdin, so the key never appears in a process argument list. Configured
  team-scope selectors travel in the same stdin header block. ~/.glm/quota/
  holds the raw response body and curl stderr, never the key.

EXIT STATUS
  0  Command succeeded; DONE, BLOCKED, and NO_REPORT are successful worker
     turns. quota exits 0 for QUOTA_STATUS=OK, even when a window is exhausted.
  1  Claude invocation or worker response failed (STATUS=INVALID).
     quota exits 1 when the lookup failed (QUOTA_STATUS=INVALID).
  2  Invalid CLI usage, configuration, dependency, or worker state.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

require_command() {
  local command_name="$1"
  command -v "$command_name" >/dev/null 2>&1 ||
    die "required command not found: $command_name"
}

validate_single_line() {
  local label="$1"
  local value="$2"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] ||
    die "$label must be a single line"
}

validate_worker_id() {
  local worker_id="$1"
  [[ "$worker_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "invalid worker id: $worker_id"
}

validate_role() {
  case "$1" in
    explorer|general-purpose) return 0 ;;
    *) die "invalid role: $1" ;;
  esac
}

role_prompt_file() {
  printf '%s/%s.md\n' "$ROLE_PROMPTS_DIR" "$1"
}

ensure_state_home() {
  mkdir -p "$GLM_AGENT_HOME"
  chmod 700 "$GLM_AGENT_HOME"
}

# The stored file is the only key source; the ZAI_API_KEY environment
# variable is deliberately never read.
load_api_key() {
  [[ -f "$AUTH_FILE" ]] ||
    die "API key is not configured. Run: $PROGRAM api-key"

  API_KEY="$(<"$AUTH_FILE")" ||
    die "cannot read the stored API key: $AUTH_FILE"
  [[ -n "$API_KEY" ]] || die "stored API key is empty"
}

# Resolves the quota scope. ZAI_QUOTA_ORGANIZATION and ZAI_QUOTA_PROJECT
# override the stored selectors one by one; both set means team, neither
# means personal, and exactly one is a configuration error. Sets
# ZAI_QUOTA_SCOPE, ZAI_QUOTA_ORGANIZATION, and ZAI_QUOTA_PROJECT.
load_team_scope() {
  local file_org='' file_proj='' scope_raw=''

  if [[ -f "$TEAM_SCOPE_FILE" ]]; then
    scope_raw="$(cat "$TEAM_SCOPE_FILE")" ||
      die "cannot read the stored team scope: $TEAM_SCOPE_FILE"
    file_org="${scope_raw%%$'\n'*}"
    file_proj="${scope_raw#*$'\n'}"
    [[ "$file_org" == organization=* ]] ||
      die "team scope file must start with an organization= line: $TEAM_SCOPE_FILE"
    [[ "$file_proj" == project=* ]] ||
      die "team scope file must carry a project= line: $TEAM_SCOPE_FILE"
    file_org="${file_org#organization=}"
    file_proj="${file_proj#project=}"
  fi

  ZAI_QUOTA_ORGANIZATION="${ZAI_QUOTA_ORGANIZATION:-$file_org}"
  ZAI_QUOTA_PROJECT="${ZAI_QUOTA_PROJECT:-$file_proj}"

  if [[ -n "$ZAI_QUOTA_ORGANIZATION" || -n "$ZAI_QUOTA_PROJECT" ]]; then
    [[ -n "$ZAI_QUOTA_ORGANIZATION" && -n "$ZAI_QUOTA_PROJECT" ]] ||
      die "team scope needs both an organization and a project. Run: $PROGRAM team-scope <organization> <project>"
    validate_single_line "team organization" "$ZAI_QUOTA_ORGANIZATION"
    validate_single_line "team project" "$ZAI_QUOTA_PROJECT"
    ZAI_QUOTA_SCOPE=team
  else
    ZAI_QUOTA_SCOPE=personal
  fi
}

require_execution_dependencies() {
  require_command claude
  require_command jq
}

require_system_prompt_file() {
  [[ -f "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file not found: $SYSTEM_PROMPT_FILE"
  [[ -r "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file is not readable: $SYSTEM_PROMPT_FILE"
  [[ -s "$SYSTEM_PROMPT_FILE" ]] ||
    die "system prompt file is empty: $SYSTEM_PROMPT_FILE"
}

run_glm_claude() {
  require_command claude

  env \
    -u CLAUDECODE \
    -u ZAI_API_KEY \
    ANTHROPIC_BASE_URL="$ZAI_BASE_URL" \
    ANTHROPIC_AUTH_TOKEN="$API_KEY" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$ZAI_HAIKU_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$ZAI_SONNET_MODEL" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$ZAI_OPUS_MODEL" \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    API_TIMEOUT_MS=3000000 \
    claude "$@"
}

new_worker_id() {
  printf '%s-%s-%s\n' \
    "$(date -u +%Y%m%dT%H%M%SZ)" \
    "$$" \
    "${RANDOM:-0}"
}

new_claude_session_id() {
  local hex

  hex="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$hex" =~ ^[0-9a-f]{32}$ ]] || die "failed to allocate Claude session id"
  hex="${hex:0:12}4${hex:13:3}8${hex:17}"
  printf '%s-%s-%s-%s-%s\n' \
    "${hex:0:8}" "${hex:8:4}" "${hex:12:4}" "${hex:16:4}" "${hex:20:12}"
}

worker_dir() {
  printf '%s/%s\n' "$WORKERS_DIR" "$1"
}

meta_get() {
  local dir="$1"
  local key="$2"
  sed -n "s/^${key}=//p" "$dir/meta" | head -n 1
}

snapshot_get() {
  local snapshot="$1"
  local key="$2"

  printf '%s\n' "$snapshot" | sed -n "s/^${key}=//p" | head -n 1
}

meta_update() {
  local dir="$1"
  local tmp
  local line
  local line_key
  local skip
  local i
  local -a keys
  local -a values

  shift
  (($# > 0 && $# % 2 == 0)) || die "meta_update requires key/value pairs"
  keys=()
  values=()
  while (($#)); do
    validate_single_line "metadata value for $1" "$2"
    keys+=("$1")
    values+=("$2")
    shift 2
  done

  tmp="$(mktemp "$dir/.meta.XXXXXX")"
  chmod 600 "$tmp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_key="${line%%=*}"
    skip=false
    for ((i = 0; i < ${#keys[@]}; i++)); do
      if [[ "$line_key" == "${keys[$i]}" ]]; then
        skip=true
        break
      fi
    done
    [[ "$skip" == "true" ]] || printf '%s\n' "$line" >>"$tmp"
  done <"$dir/meta"
  for ((i = 0; i < ${#keys[@]}; i++)); do
    printf '%s=%s\n' "${keys[$i]}" "${values[$i]}" >>"$tmp"
  done
  mv "$tmp" "$dir/meta"
}

meta_set() {
  meta_update "$1" "$2" "$3"
}

active_get() {
  local dir="$1"
  local key="$2"
  local state_file="$dir/active/state"

  [[ -f "$state_file" ]] || return 0
  sed -n "s/^${key}=//p" "$state_file" 2>/dev/null | head -n 1 || return 0
}

active_update() {
  local dir="$1"
  local generation="$2"
  local state_file="$dir/active/state"
  local tmp
  local line
  local line_key
  local skip
  local i
  local -a keys
  local -a values

  shift 2
  (($# > 0 && $# % 2 == 0)) || die "active_update requires key/value pairs"
  [[ -d "$dir/active" && -f "$state_file" ]] ||
    die "worker has no active lock: $(meta_get "$dir" worker_id)"
  [[ "$(active_get "$dir" generation)" == "$generation" ]] ||
    die "worker active generation changed: $(meta_get "$dir" worker_id)"
  keys=()
  values=()
  while (($#)); do
    validate_single_line "active metadata value for $1" "$2"
    keys+=("$1")
    values+=("$2")
    shift 2
  done
  tmp="$(mktemp "$dir/active/.state.XXXXXX")"
  chmod 600 "$tmp"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_key="${line%%=*}"
    skip=false
    for ((i = 0; i < ${#keys[@]}; i++)); do
      if [[ "$line_key" == "${keys[$i]}" ]]; then
        skip=true
        break
      fi
    done
    [[ "$skip" == "true" ]] || printf '%s\n' "$line" >>"$tmp"
  done <"$state_file"
  for ((i = 0; i < ${#keys[@]}; i++)); do
    printf '%s=%s\n' "${keys[$i]}" "${values[$i]}" >>"$tmp"
  done
  mv "$tmp" "$state_file"
}

active_set() {
  active_update "$1" "$2" "$3" "$4"
}

acquire_worker_lock() {
  local dir="$1"
  local mode="$2"
  local generation="$3"
  local active_dir="$dir/active"
  local tmp_state="$active_dir/.state.$$"

  if ! mkdir "$active_dir" 2>/dev/null; then
    die "worker is active: $(meta_get "$dir" worker_id)"
  fi
  chmod 700 "$active_dir"
  (
    umask 077
    cat >"$tmp_state" <<EOF
generation=$generation
mode=$mode
turn=
supervision=
runner_pid=
runner_start=
provider_pid=
provider_pgid=
provider_start=
started_at=$(date +%s)
EOF
  )
  chmod 600 "$tmp_state"
  mv "$tmp_state" "$active_dir/state"
}

release_worker_lock() {
  local dir="$1"
  local generation="$2"
  local finalize_nonce="${3:-}"
  local active_dir="$dir/active"
  local claim_dir="$active_dir/finalizing"
  local current_owner
  local current_nonce
  local did_something=false

  [[ -d "$active_dir" ]] || return 0

  # Claim-directory cleanup is decided by nonce ownership alone, independent
  # of the generation/state check below. Two finalizers can both believe
  # they hold the claim (see claim_finalization); only the one whose nonce
  # is still current here actually removes it. Gating this on the
  # generation check too would let the loser's state-removal race ahead of
  # the winner's release and permanently wedge active/finalizing (the
  # winner's later generation check would then see no state to match and
  # skip its own cleanup).
  if [[ -n "$finalize_nonce" ]]; then
    current_owner=""
    [[ -f "$claim_dir/owner" ]] && current_owner="$(cat "$claim_dir/owner" 2>/dev/null)"
    current_nonce="$(snapshot_get "$current_owner" nonce)"
    if [[ -n "$current_nonce" && "$current_nonce" == "$finalize_nonce" ]]; then
      rm -f "$claim_dir/owner"
      rmdir "$claim_dir" 2>/dev/null || true
      did_something=true
    fi
  fi

  if [[ "$(active_get "$dir" generation)" == "$generation" ]]; then
    rm -f "$active_dir/state" "$active_dir/cancel.requested" \
      "$active_dir/launch.ready"
    rm -f "$dir/cancel.$generation.requested"
    if [[ -z "$finalize_nonce" ]]; then
      rm -f "$claim_dir/owner"
      rmdir "$claim_dir" 2>/dev/null || true
    fi
    did_something=true
  fi

  if [[ "$did_something" == "true" ]]; then
    rmdir "$active_dir" 2>/dev/null || true
  fi
  return 0
}

CLAIM_FINALIZATION_NONCE=""

claim_finalization() {
  local dir="$1"
  local generation="$2"
  local claim_dir="$dir/active/finalizing"
  local owner=""
  local owner_pid
  local owner_start
  local claim_mtime
  local now
  local nonce
  local tmp_owner
  local reread_owner
  local reread_nonce

  CLAIM_FINALIZATION_NONCE=""
  nonce="$$-${RANDOM:-0}-$(date +%s%N 2>/dev/null || date +%s)"

  if mkdir "$claim_dir" 2>/dev/null; then
    chmod 700 "$claim_dir"
    printf 'pid=%s\nstart=%s\nnonce=%s\n' "$$" "$(process_start_identity "$$")" \
      "$nonce" >"$claim_dir/owner"
    chmod 600 "$claim_dir/owner"
  else
    owner=""
    [[ -f "$claim_dir/owner" ]] && owner="$(cat "$claim_dir/owner" 2>/dev/null)"
    owner_pid="$(snapshot_get "$owner" pid)"
    owner_start="$(snapshot_get "$owner" start)"
    if [[ -n "$owner_pid" && -n "$owner_start" ]] &&
      process_matches_start "$owner_pid" "$owner_start"; then
      return 1
    fi
    if [[ -z "$owner_pid" || -z "$owner_start" ]]; then
      claim_mtime="$(path_mtime "$claim_dir")"
      now="$(date +%s)"
      if [[ ! "$claim_mtime" =~ ^[0-9]+$ ]] || ((now - claim_mtime < 5)); then
        return 1
      fi
    fi

    tmp_owner="$claim_dir/owner.new.$$"
    printf 'pid=%s\nstart=%s\nnonce=%s\n' "$$" "$(process_start_identity "$$")" \
      "$nonce" >"$tmp_owner"
    chmod 600 "$tmp_owner"
    if ! mv "$tmp_owner" "$claim_dir/owner" 2>/dev/null; then
      rm -f "$tmp_owner"
      return 1
    fi
    reread_owner="$(cat "$claim_dir/owner" 2>/dev/null)" || reread_owner=""
    reread_nonce="$(snapshot_get "$reread_owner" nonce)"
    [[ -n "$reread_nonce" && "$reread_nonce" == "$nonce" ]] || return 1
  fi

  if [[ "$(active_get "$dir" generation)" != "$generation" ]]; then
    return 1
  fi

  CLAIM_FINALIZATION_NONCE="$nonce"
  return 0
}

new_active_generation() {
  printf '%s-%s-%s\n' "$(date +%s)" "$$" "${RANDOM:-0}"
}

process_is_alive() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

path_mtime() {
  local path="$1"
  local mtime

  if mtime="$(stat -f '%m' "$path" 2>/dev/null)" && [[ "$mtime" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$mtime"
    return 0
  fi
  if mtime="$(stat -c '%Y' "$path" 2>/dev/null)" && [[ "$mtime" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$mtime"
    return 0
  fi
  return 1
}

process_conflicts_with_start() {
  local pid="$1"
  local expected_start="$2"
  local state
  local actual_start

  [[ "$pid" =~ ^[1-9][0-9]*$ && -n "$expected_start" ]] || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ')"
  [[ -n "$state" && "$state" != Z* ]] || return 1
  actual_start="$(process_start_identity "$pid")"
  [[ -n "$actual_start" && "$actual_start" != "$expected_start" ]]
}

process_start_identity() {
  local pid="$1"

  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  ps -o lstart= -p "$pid" 2>/dev/null | sed \
    -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

process_matches_start() {
  local pid="$1"
  local expected_start="$2"
  local actual_start

  [[ -n "$expected_start" ]] || return 1
  actual_start="$(process_start_identity "$pid")"
  [[ -n "$actual_start" && "$actual_start" == "$expected_start" ]]
}

process_group_is_alive() {
  local pgid="$1"
  [[ "$pgid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 -- "-$pgid" 2>/dev/null
}

provider_identity_matches() {
  local provider_pid="$1"
  local provider_pgid="$2"
  local provider_start="$3"
  local actual_pgid
  local own_pgid

  [[ "$provider_pid" =~ ^[1-9][0-9]*$ &&
     "$provider_pgid" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$provider_pid" == "$provider_pgid" ]] || return 1
  process_matches_start "$provider_pid" "$provider_start" || return 1
  own_pgid="$(ps -o pgid= -p "$$" | tr -d ' ')"
  [[ "$provider_pgid" != "$own_pgid" ]] || return 1
  actual_pgid="$(ps -o pgid= -p "$provider_pid" 2>/dev/null | tr -d ' ')"
  [[ "$actual_pgid" == "$provider_pgid" ]]
}

signal_provider_identity() {
  local provider_pid="$1"
  local provider_pgid="$2"
  local provider_start="$3"
  local signal="$4"

  provider_identity_matches "$provider_pid" "$provider_pgid" \
    "$provider_start" || return 1
  kill "-$signal" -- "-$provider_pgid" 2>/dev/null
}

drain_owned_provider_group() {
  local provider_pgid="$1"
  local provider_start="$2"
  local i

  [[ "$provider_pgid" =~ ^[1-9][0-9]*$ && -n "$provider_start" ]] || return 1
  if process_conflicts_with_start "$provider_pgid" "$provider_start"; then
    return 1
  fi
  process_group_is_alive "$provider_pgid" || return 0
  kill -TERM -- "-$provider_pgid" 2>/dev/null || true
  for ((i = 0; i < 10; i++)); do
    process_group_is_alive "$provider_pgid" || return 0
    sleep 0.1
  done
  if process_group_is_alive "$provider_pgid"; then
    if process_conflicts_with_start "$provider_pgid" "$provider_start"; then
      return 1
    fi
    kill -KILL -- "-$provider_pgid" 2>/dev/null || true
  fi
}

SUPERVISED_PROVIDER_PID=""
SUPERVISED_PROVIDER_PGID=""
SUPERVISED_PROVIDER_START=""

forward_provider_and_exit() {
  local exit_code="$1"

  trap - INT TERM HUP EXIT
  signal_provider_identity "$SUPERVISED_PROVIDER_PID" \
    "$SUPERVISED_PROVIDER_PGID" "$SUPERVISED_PROVIDER_START" TERM || true
  drain_owned_provider_group "$SUPERVISED_PROVIDER_PGID" \
    "$SUPERVISED_PROVIDER_START" || true
  wait "$SUPERVISED_PROVIDER_PID" 2>/dev/null || true
  exit "$exit_code"
}

turn_result_path() {
  local dir="$1"
  local turn="$2"
  local turn_label

  printf -v turn_label '%04d' "$turn"
  printf '%s/turns/%s/result.md\n' "$dir" "$turn_label"
}

finalize_interrupted_turn() {
  local dir="$1"
  local generation="$2"
  local nonce
  local state
  local provider_pgid
  local provider_start

  claim_finalization "$dir" "$generation" || return 0
  nonce="$CLAIM_FINALIZATION_NONCE"
  # claim_finalization just re-validated that this generation is still the
  # active one, so active/state (if any) still describes it: drain any
  # provider process group it recorded before releasing the lock, so an
  # orphaned provider never keeps running past the lock that owned it.
  state="$(cat "$dir/active/state" 2>/dev/null)" || state=""
  provider_pgid="$(snapshot_get "$state" provider_pgid)"
  provider_start="$(snapshot_get "$state" provider_start)"
  drain_owned_provider_group "$provider_pgid" "$provider_start" || true
  meta_update "$dir" status "INVALID" error_kind "interrupted" provider_code ""
  release_worker_lock "$dir" "$generation" "$nonce"
}

recover_orphaned_active_lock() {
  local dir="$1"
  local claim_dir="$dir/active/orphan-cleanup"

  # The caller (recover_stale_lock) already confirmed active/ is >= 5s old
  # with no state file. mkdir-ing our own claim subdirectory here bumps
  # active/'s own mtime, so re-reading that mtime afterward would only ever
  # observe "now" — it cannot be used as a second freshness gate. Re-check
  # only that a legitimate turn has not started (state appeared) between
  # that outer check and this claim.
  mkdir "$claim_dir" 2>/dev/null || return 0
  if [[ -f "$dir/active/state" ]]; then
    rmdir "$claim_dir" 2>/dev/null || true
    return 0
  fi
  meta_update "$dir" status "INVALID" error_kind "interrupted" provider_code ""
  rm -rf "$dir/active"
}

release_stale_close_lock() {
  local dir="$1"
  local generation="$2"
  local nonce

  claim_finalization "$dir" "$generation" || return 0
  nonce="$CLAIM_FINALIZATION_NONCE"
  release_worker_lock "$dir" "$generation" "$nonce"
}

recover_stale_lock() {
  local dir="$1"
  local state
  local generation
  local mode
  local runner_pid
  local runner_start
  local started_at
  local now
  local active_mtime

  [[ -d "$dir/active" ]] || return 0
  if [[ ! -f "$dir/active/state" ]]; then
    active_mtime="$(path_mtime "$dir/active")"
    now="$(date +%s)"
    if [[ "$active_mtime" =~ ^[0-9]+$ ]] && ((now - active_mtime >= 5)); then
      recover_orphaned_active_lock "$dir"
    fi
    return 0
  fi
  state="$(cat "$dir/active/state" 2>/dev/null)" || return 0
  generation="$(snapshot_get "$state" generation)"
  mode="$(snapshot_get "$state" mode)"
  runner_pid="$(snapshot_get "$state" runner_pid)"
  runner_start="$(snapshot_get "$state" runner_start)"
  started_at="$(snapshot_get "$state" started_at)"
  now="$(date +%s)"

  if [[ -z "$runner_pid" || -z "$runner_start" ]]; then
    if [[ ! "$started_at" =~ ^[0-9]+$ ]] || ((now - started_at >= 5)); then
      # close never records a runner identity (it does its work inline, not
      # via a supervised runner), so an interrupted close always lands here.
      # It must never be treated as an interrupted turn: that would stamp
      # INVALID/interrupted over whatever real terminal status the worker's
      # last turn actually had.
      if [[ "$mode" == "close" ]]; then
        release_stale_close_lock "$dir" "$generation"
      else
        finalize_interrupted_turn "$dir" "$generation"
      fi
    fi
    return 0
  fi
  if ! process_matches_start "$runner_pid" "$runner_start"; then
    finalize_interrupted_turn "$dir" "$generation"
  fi
}

WORKER_META_SNAPSHOT=""
WORKER_ACTIVE_SNAPSHOT=""
WORKER_HAS_ACTIVE=false

load_worker_snapshot() {
  local dir="$1"
  local active_file="$dir/active/state"
  local meta_before
  local meta_after
  local active_before
  local active_after

  for _ in {1..50}; do
    if [[ -f "$active_file" ]]; then
      active_before="$(cat "$active_file" 2>/dev/null)" || {
        sleep 0.01
        continue
      }
      meta_after="$(cat "$dir/meta")"
      active_after="$(cat "$active_file" 2>/dev/null)" || {
        sleep 0.01
        continue
      }
      if [[ -f "$active_file" &&
         "$active_before" == "$active_after" &&
         -n "$(snapshot_get "$active_after" generation)" &&
         -n "$(snapshot_get "$active_after" mode)" &&
         -n "$(snapshot_get "$active_after" turn)" &&
         -n "$(snapshot_get "$active_after" supervision)" ]]; then
        WORKER_META_SNAPSHOT="$meta_after"
        WORKER_ACTIVE_SNAPSHOT="$active_after"
        WORKER_HAS_ACTIVE=true
        return 0
      fi
    elif [[ -d "$dir/active" ]]; then
      :
    else
      meta_before="$(cat "$dir/meta")"
      [[ ! -d "$dir/active" ]] || {
        sleep 0.01
        continue
      }
      meta_after="$(cat "$dir/meta")"
      if [[ ! -d "$dir/active" && "$meta_before" == "$meta_after" ]]; then
        WORKER_META_SNAPSHOT="$meta_after"
        WORKER_ACTIVE_SNAPSHOT=""
        WORKER_HAS_ACTIVE=false
        return 0
      fi
    fi
    sleep 0.01
  done
  return 1
}

require_worker() {
  local worker_id="$1"
  local dir

  validate_worker_id "$worker_id"
  dir="$(worker_dir "$worker_id")"
  [[ -f "$dir/meta" ]] || die "worker not found: $worker_id"
}

print_no_report_fields() {
  local status="$1"
  local meta="$2"
  local reply

  [[ "$status" == "NO_REPORT" ]] || return 0
  reply="$(snapshot_get "$meta" reply)"
  printf 'REASON=%s\n' "$(snapshot_get "$meta" reason)"
  printf 'REPLY=%s\n' "$reply"
  if [[ -n "$reply" ]]; then
    printf '%s\n' 'NEXT=read-reply'
  else
    printf '%s\n' 'NEXT=inspect-changes'
  fi
}

print_turn_control() {
  local dir="$1"
  local turn="$2"
  local status="$3"
  local result_file="$4"
  local error_kind="$5"
  local provider_code="$6"
  local meta

  meta="$(cat "$dir/meta")"
  printf 'WORKER_ID=%s\n' "$(snapshot_get "$meta" worker_id)"
  printf 'TURN=%s\n' "$turn"
  printf 'MODEL=%s\n' "$(snapshot_get "$meta" model)"
  printf 'ROLE=%s\n' "$(snapshot_get "$meta" role)"
  printf 'STATUS=%s\n' "$status"
  printf 'RESULT=%s\n' "$result_file"
  printf 'ERROR_KIND=%s\n' "$error_kind"
  printf 'PROVIDER_CODE=%s\n' "$provider_code"
  print_no_report_fields "$status" "$meta"
  if [[ "$error_kind" == "quota-exhausted" ]]; then
    printf '%s\n' 'FALLBACK_RECOMMENDED=true'
  else
    printf '%s\n' 'FALLBACK_RECOMMENDED=false'
  fi
}

extract_zai_code() {
  local response_file="$1"
  local stderr_file="$2"
  local code=""

  code="$(
    jq -r '
      if type != "object" then empty
      elif ((.error? | type) == "object") and (.error.code? != null) then
        .error.code | tostring
      elif ((.result? | type) == "string") then
        ((try (.result | capture("(?i)code[^0-9]*(?<code>[0-9]{3,4})").code)
          catch null) //
         (try (.result | capture("\\[(?<code>[0-9]{3,4})\\]").code)
          catch null) //
         empty)
      else empty
      end
    ' "$response_file" 2>/dev/null | head -n 1
  )" || true
  if [[ "$code" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$code"
    return 0
  fi
  code="$(
    { cat "$response_file"; cat "$stderr_file"; } 2>/dev/null |
      grep -Eo '"code"[[:space:]]*:[[:space:]]*"?[0-9]+' |
      sed -E 's/[^0-9]*([0-9]+).*/\1/' |
      head -n 1
  )" || true
  printf '%s\n' "$code"
}

provider_response_is_error() {
  local response_file="$1"

  jq -e '
    type == "object" and (
      .is_error == true
      or .subtype == "error"
      or ((.error? | type) == "object")
      or (
        ((.is_error? != false) or (.subtype? != "success"))
        and
        ((.result? | type) == "string")
        and (.result | test("(?i)(error|quota|exhausted|rate.?limit|failed|z\\.ai|authentication|model unavailable|provider error|request failed)"))
        and (.result | test("(?i)\\b(1000|1001|1003|1113|1211|1302|1305|1308|1310|1311|1316|1317|1318|1319|1320|1321)\\b"))
      )
    )
  ' "$response_file" >/dev/null 2>&1
}

classify_error_kind() {
  local provider_code="$1"
  local default_kind="$2"

  case "$provider_code" in
    1113|1308|1310|1316|1317|1318|1319|1320|1321)
      printf '%s\n' 'quota-exhausted'
      ;;
    1302|1305) printf '%s\n' 'provider-transient' ;;
    1000|1001|1003) printf '%s\n' 'authentication' ;;
    1211|1311) printf '%s\n' 'model-unavailable' ;;
    '') printf '%s\n' "$default_kind" ;;
    *) printf '%s\n' 'provider-error' ;;
  esac
}

invalidate_turn() {
  local dir="$1"
  local turn="$2"
  local result_file="$3"
  local error="$4"
  local error_kind="$5"
  local provider_code="$6"
  local generation="$7"

  meta_update "$dir" status "INVALID" error_kind "$error_kind" \
    provider_code "$provider_code"
  release_worker_lock "$dir" "$generation"
  print_turn_control "$dir" "$turn" "INVALID" "$result_file" \
    "$error_kind" "$provider_code"
  printf 'ERROR=%s\n' "$error"
  return 1
}

write_reply_file() {
  local response_file="$1"
  local reply_file="$2"
  local text

  text="$(
    jq -r '
      select(
        type == "object" and .is_error == false
        and (.result | type) == "string"
        and (.result | test("\\S"))
      ) | .result
    ' "$response_file" 2>/dev/null
  )" || return 1
  [[ -n "$text" ]] || return 1
  printf '%s\n' "$text" >"$reply_file"
  chmod 600 "$reply_file"
}

finish_no_report_turn() {
  local dir="$1"
  local turn="$2"
  local result_file="$3"
  local response_file="$4"
  local reason="$5"
  local generation="$6"
  local reply_file="${result_file%/*}/reply.md"

  write_reply_file "$response_file" "$reply_file" || reply_file=""
  meta_update "$dir" status "NO_REPORT" error_kind "" provider_code "" \
    reason "$reason" reply "$reply_file"
  release_worker_lock "$dir" "$generation"
  print_turn_control "$dir" "$turn" "NO_REPORT" "$result_file" "" ""
}

validate_worker_execution() {
  local worker_id="$1"
  local dir
  local model
  local cwd
  local current_turn
  local role
  local role_prompt_path

  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  model="$(meta_get "$dir" model)"
  role="$(meta_get "$dir" role)"
  cwd="$(meta_get "$dir" cwd)"
  current_turn="$(meta_get "$dir" turn)"

  [[ -n "$model" ]] || die "worker has no model: $worker_id"
  validate_role "$role"
  [[ -n "$cwd" ]] || die "worker has no working directory: $worker_id"
  [[ -d "$cwd" ]] || die "worker working directory does not exist: $cwd"
  [[ "$current_turn" =~ ^[0-9]+$ ]] ||
    die "worker has invalid turn metadata: $worker_id"
  require_system_prompt_file
  role_prompt_path="$(role_prompt_file "$role")"
  [[ -r "$role_prompt_path" && -s "$role_prompt_path" ]] ||
    die "role prompt file is missing, unreadable, or empty: $role_prompt_path"
}

build_turn_system_prompt() {
  local role="$1"
  local result_file="$2"
  local role_prompt_path
  local system_prompt
  local role_prompt

  role_prompt_path="$(role_prompt_file "$role")"
  system_prompt="$(<"$SYSTEM_PROMPT_FILE")"
  role_prompt="$(<"$role_prompt_path")"
  system_prompt+=$'\n\n<worker_role>\n'
  system_prompt+="$role_prompt"
  system_prompt+=$'\n</worker_role>'
  system_prompt+=$'\n\n<current_turn_result_file>\n'
  system_prompt+="For this turn, GLM_RESULT_FILE is exactly this absolute path:"
  system_prompt+=$'\n'
  system_prompt+="$result_file"
  system_prompt+=$'\nWrite the report to that exact path, then read it back as required.\n</current_turn_result_file>'
  printf '%s\n' "$system_prompt"
}

prepare_turn() {
  local worker_id="$1"
  local prompt="$2"
  local mode="$3"
  local dir
  local current_turn
  local turn
  local turn_label
  local turn_dir
  local generation

  dir="$(worker_dir "$worker_id")"
  generation="$(new_active_generation)"
  acquire_worker_lock "$dir" "$mode" "$generation"
  if [[ "$(meta_get "$dir" closed)" == "true" ]]; then
    release_worker_lock "$dir" "$generation"
    die "worker is closed: $worker_id"
  fi
  current_turn="$(meta_get "$dir" turn)"
  turn="$((10#$current_turn + 1))"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"

  if ! mkdir "$turn_dir"; then
    release_worker_lock "$dir" "$generation"
    die "turn already exists: $worker_id/$turn_label"
  fi
  chmod 700 "$turn_dir"
  printf '%s\n' "$mode" >"$turn_dir/mode"
  printf '%s\n' "$prompt" >"$turn_dir/prompt.md"
  chmod 600 "$turn_dir/mode" "$turn_dir/prompt.md"

  active_set "$dir" "$generation" turn "$turn"
  meta_update "$dir" turn "$turn" status "RUNNING" error_kind "" \
    provider_code "" reason "" reply ""
  printf '%s\n' "$turn"
}

execute_headless_turn() {
  local worker_id="$1"
  local turn="$2"
  local generation="$3"
  local dir
  local model
  local cwd
  local session_id
  local turn_label
  local turn_dir
  local prompt
  local response_file
  local stderr_file
  local result_file
  local exit_code=0
  local returned_session_id
  local result_status
  local provider_code
  local error_kind
  local error_label
  local system_prompt
  local role
  local role_prompt_path
  local role_prompt
  local provider_pid
  local provider_pgid
  local provider_start
  local cancel_file
  local provider_ready_file
  local provider_go_file
  local provider_ready=false
  local -a args

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"

  dir="$(worker_dir "$worker_id")"
  [[ "$(active_get "$dir" generation)" == "$generation" &&
     "$(active_get "$dir" mode)" == "headless" &&
     "$(active_get "$dir" turn)" == "$turn" ]] ||
    die "worker active turn does not match: $worker_id/$turn"
  model="$(meta_get "$dir" model)"
  role="$(meta_get "$dir" role)"
  cwd="$(meta_get "$dir" cwd)"
  session_id="$(meta_get "$dir" claude_session_id)"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  prompt="$(<"$turn_dir/prompt.md")"
  response_file="$turn_dir/response.json"
  stderr_file="$turn_dir/stderr.log"
  result_file="$turn_dir/result.md"
  cancel_file="$dir/cancel.$generation.requested"
  provider_ready_file="$turn_dir/.provider.ready"
  provider_go_file="$turn_dir/.provider.go"
  validate_single_line "result file path" "$result_file"

  system_prompt="$(build_turn_system_prompt "$role" "$result_file")"

  args=(
    -p
    --model "$model"
    --output-format json
    --dangerously-skip-permissions
    --append-system-prompt "$system_prompt"
  )
  if [[ -n "$session_id" ]]; then
    args+=(--resume "$session_id")
  fi

  if [[ -f "$cancel_file" ]]; then
    : >"$response_file"
    : >"$stderr_file"
    chmod 600 "$response_file" "$stderr_file"
    invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
      "interrupted" "" "$generation"
    return 1
  fi

  set -m
  (
    : >"$provider_ready_file"
    for _ in {1..500}; do
      [[ -f "$provider_go_file" ]] && break
      sleep 0.01
    done
    [[ -f "$provider_go_file" ]] || exit 125
    cd "$cwd"
    GLM_RESULT_FILE="$result_file" run_glm_claude "${args[@]}" "$prompt"
  ) >"$response_file" 2>"$stderr_file" &
  provider_pid=$!
  for _ in {1..500}; do
    if [[ -f "$provider_ready_file" ]]; then
      provider_ready=true
      break
    fi
    sleep 0.01
  done
  provider_pgid="$(ps -o pgid= -p "$provider_pid" | tr -d ' ')"
  provider_start="$(process_start_identity "$provider_pid")"
  if [[ "$provider_ready" != "true" ]] || \
    ! provider_identity_matches "$provider_pid" "$provider_pgid" \
    "$provider_start"; then
    kill "$provider_pid" 2>/dev/null || true
    wait "$provider_pid" 2>/dev/null || true
    set +m
    invalidate_turn "$dir" "$turn" "$result_file" \
      "provider-process-group-missing" "invocation" "" "$generation"
    return 1
  fi
  SUPERVISED_PROVIDER_PID="$provider_pid"
  SUPERVISED_PROVIDER_PGID="$provider_pgid"
  SUPERVISED_PROVIDER_START="$provider_start"
  trap 'forward_provider_and_exit 130' INT
  trap 'forward_provider_and_exit 143' TERM
  trap 'forward_provider_and_exit 129' HUP
  trap 'forward_provider_and_exit $?' EXIT
  active_update "$dir" "$generation" provider_pid "$provider_pid" \
    provider_pgid "$provider_pgid" provider_start "$provider_start"
  : >"$provider_go_file"
  if [[ -f "$cancel_file" ]]; then
    signal_provider_identity "$provider_pid" "$provider_pgid" \
      "$provider_start" TERM || true
  fi
  if wait "$provider_pid"; then
    exit_code=0
  else
    exit_code=$?
  fi
  trap - INT TERM HUP EXIT
  SUPERVISED_PROVIDER_PID=""
  SUPERVISED_PROVIDER_PGID=""
  SUPERVISED_PROVIDER_START=""
  set +m
  rm -f "$provider_ready_file" "$provider_go_file"

  chmod 600 "$response_file" "$stderr_file"

  if [[ -f "$cancel_file" ]]; then
    drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
      "interrupted" "" "$generation"
    return 1
  fi

  provider_code="$(extract_zai_code "$response_file" "$stderr_file")"
  if ((exit_code != 0)) || provider_response_is_error "$response_file"; then
    drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    if ((exit_code != 0)); then
      error_label="claude-exit-$exit_code"
      error_kind="$(classify_error_kind "$provider_code" "invocation")"
    else
      error_label="claude-error-response"
      error_kind="$(classify_error_kind "$provider_code" "provider-error")"
    fi
    invalidate_turn "$dir" "$turn" "$result_file" "$error_label" \
      "$error_kind" "$provider_code" "$generation"
    return 1
  fi

  if ! returned_session_id="$(
    jq -er '
      select(type == "object" and (.is_error != true))
      | .session_id
      | select(type == "string" and length > 0)
    ' "$response_file" 2>/dev/null
  )"; then
    drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    invalidate_turn "$dir" "$turn" "$result_file" "invalid-response" \
      "worker-protocol" "" "$generation"
    return 1
  fi

  if [[ -n "$session_id" && "$returned_session_id" != "$session_id" ]]; then
    drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    invalidate_turn "$dir" "$turn" "$result_file" "unexpected-session-id" \
      "worker-protocol" "" "$generation"
    return 1
  fi

  if [[ -z "$session_id" ]]; then
    meta_set "$dir" claude_session_id "$returned_session_id"
  fi

  if [[ ! -s "$result_file" ]]; then
    drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    finish_no_report_turn "$dir" "$turn" "$result_file" "$response_file" \
      "result-file-missing" "$generation"
    return 0
  fi
  chmod 600 "$result_file"

  case "$(tail -n 1 "$result_file")" in
    'STATUS: DONE')
      result_status="DONE"
      ;;
    'STATUS: BLOCKED')
      result_status="BLOCKED"
      ;;
    *)
      drain_owned_provider_group "$provider_pgid" "$provider_start" || true
      finish_no_report_turn "$dir" "$turn" "$result_file" "$response_file" \
        "result-status-invalid" "$generation"
      return 0
      ;;
  esac

  meta_update "$dir" status "$result_status" latest_result "$result_file" \
    error_kind "" provider_code ""
  release_worker_lock "$dir" "$generation"
  print_turn_control "$dir" "$turn" "$result_status" "$result_file" "" ""
}

run_turn() {
  local worker_id="$1"
  local prompt="$2"
  local turn
  local dir
  local generation
  local runner_start

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"
  turn="$(prepare_turn "$worker_id" "$prompt" "headless")"
  dir="$(worker_dir "$worker_id")"
  generation="$(active_get "$dir" generation)"
  runner_start="$(process_start_identity "$$")"
  active_update "$dir" "$generation" supervision "sync" runner_pid "$$" \
    runner_start "$runner_start"
  execute_headless_turn "$worker_id" "$turn" "$generation"
}

launch_async_turn() {
  local worker_id="$1"
  local turn="$2"
  local dir
  local turn_label
  local turn_dir
  local result_file
  local runner_pid
  local runner_pgid
  local runner_start
  local generation

  dir="$(worker_dir "$worker_id")"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  result_file="$turn_dir/result.md"
  generation="$(active_get "$dir" generation)"

  set -m
  nohup "$SCRIPT_PATH" _execute-turn "$worker_id" "$turn" \
    </dev/null >"$turn_dir/runner.log" 2>&1 &
  runner_pid=$!
  set +m
  runner_pgid="$(ps -o pgid= -p "$runner_pid" | tr -d ' ')"
  runner_start="$(process_start_identity "$runner_pid")"
  if [[ "$runner_pgid" != "$runner_pid" || -z "$runner_start" ]]; then
    kill -TERM "$runner_pid" 2>/dev/null || true
    wait "$runner_pid" 2>/dev/null || true
    invalidate_turn "$dir" "$turn" "$result_file" \
      "runner-process-group-missing" "invocation" "" "$generation"
    return 1
  fi
  chmod 600 "$turn_dir/runner.log"
  active_update "$dir" "$generation" supervision "async" \
    runner_pid "$runner_pid" runner_start "$runner_start"
  print_turn_control "$dir" "$turn" "RUNNING" "$result_file" "" ""
  : >"$dir/active/launch.ready"
  chmod 600 "$dir/active/launch.ready"
}

run_turn_async() {
  local worker_id="$1"
  local prompt="$2"
  local turn

  require_execution_dependencies
  load_api_key
  validate_worker_execution "$worker_id"
  turn="$(prepare_turn "$worker_id" "$prompt" "headless")"
  launch_async_turn "$worker_id" "$turn"
}

cmd_execute_turn() {
  (($# == 2)) || die "_execute-turn requires a worker-id and turn"

  local worker_id="$1"
  local turn="$2"
  local dir
  local result_file
  local turn_label
  local turn_dir
  local ready=false
  local generation
  local runner_start
  local cancel_file

  validate_worker_id "$worker_id"
  [[ "$turn" =~ ^[1-9][0-9]*$ ]] || die "invalid turn: $turn"
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  printf -v turn_label '%04d' "$turn"
  turn_dir="$dir/turns/$turn_label"
  result_file="$turn_dir/result.md"
  generation="$(active_get "$dir" generation)"
  cancel_file="$dir/cancel.$generation.requested"

  for _ in {1..500}; do
    if [[ -f "$cancel_file" ]]; then
      : >"$turn_dir/response.json"
      : >"$turn_dir/stderr.log"
      chmod 600 "$turn_dir/response.json" "$turn_dir/stderr.log"
      invalidate_turn "$dir" "$turn" "$result_file" "cancelled" \
        "interrupted" "" "$generation"
      return 1
    fi
    if [[ -f "$dir/active/launch.ready" ]]; then
      ready=true
      break
    fi
    sleep 0.01
  done
  if [[ "$ready" != "true" ]]; then
    finalize_interrupted_turn "$dir" "$generation"
    die "async launch handshake timed out: $worker_id/$turn"
  fi
  [[ "$(active_get "$dir" runner_pid)" == "$$" ]] ||
    die "async runner identity does not match: $worker_id/$turn"
  runner_start="$(active_get "$dir" runner_start)"
  process_matches_start "$$" "$runner_start" ||
    die "async runner start identity does not match: $worker_id/$turn"
  [[ "$(active_get "$dir" turn)" == "$turn" ]] ||
    die "async runner turn does not match: $worker_id/$turn"

  execute_headless_turn "$worker_id" "$turn" "$generation"
}

print_observed_turn() {
  local dir="$1"
  local status="$2"
  local meta="${3:-}"
  local observed_turn="${4:-}"
  local turn
  local result_file

  [[ -n "$meta" ]] || meta="$(cat "$dir/meta")"
  turn="${observed_turn:-$(snapshot_get "$meta" turn)}"
  result_file="$(turn_result_path "$dir" "$turn")"
  if [[ "$status" == "RUNNING" ]]; then
    print_turn_control "$dir" "$turn" "$status" "$result_file" "" ""
  else
    print_turn_control "$dir" "$turn" "$status" "$result_file" \
      "$(snapshot_get "$meta" error_kind)" \
      "$(snapshot_get "$meta" provider_code)"
  fi
}

create_worker() {
  local model="$1"
  local role="$2"
  local cwd="$3"
  local task="$4"
  local session_id="${5:-}"
  local worker_id
  local dir

  ensure_state_home
  mkdir -p "$WORKERS_DIR"
  chmod 700 "$WORKERS_DIR"
  worker_id="$(new_worker_id)"
  dir="$(worker_dir "$worker_id")"
  mkdir "$dir"
  chmod 700 "$dir"
  mkdir "$dir/turns"
  chmod 700 "$dir/turns"

  (
    umask 077
    cat >"$dir/meta" <<EOF
worker_id=$worker_id
claude_session_id=$session_id
model=$model
role=$role
cwd=$cwd
turn=0
status=NEW
closed=false
latest_result=
error_kind=
provider_code=
EOF
    printf '%s\n' "$task" >"$dir/task.md"
  )
  printf '%s\n' "$worker_id"
}

active_generation_matches() {
  local dir="$1"
  local generation="$2"

  [[ -f "$dir/active/state" ]] || return 1
  [[ "$(active_get "$dir" generation)" == "$generation" ]]
}

runner_identity_matches_snapshot() {
  local dir="$1"
  local state="$2"
  local runner_pid
  local runner_start
  local worker_id
  local turn
  local supervision
  local command_line

  runner_pid="$(snapshot_get "$state" runner_pid)"
  runner_start="$(snapshot_get "$state" runner_start)"
  worker_id="$(meta_get "$dir" worker_id)"
  turn="$(snapshot_get "$state" turn)"
  supervision="$(snapshot_get "$state" supervision)"
  process_matches_start "$runner_pid" "$runner_start" || return 1
  [[ "$supervision" == "async" ]] || return 0
  command_line="$(ps -o command= -p "$runner_pid" 2>/dev/null || true)"
  [[ "$command_line" == *"_execute-turn $worker_id $turn"* ]]
}

provider_identity_matches_snapshot() {
  local dir="$1"
  local state="$2"
  local provider_pid
  local provider_pgid
  local provider_start
  local worker_id
  local turn
  local command_line

  provider_pid="$(snapshot_get "$state" provider_pid)"
  provider_pgid="$(snapshot_get "$state" provider_pgid)"
  provider_start="$(snapshot_get "$state" provider_start)"
  provider_identity_matches "$provider_pid" "$provider_pgid" \
    "$provider_start" || return 1
  worker_id="$(meta_get "$dir" worker_id)"
  turn="$(snapshot_get "$state" turn)"
  command_line="$(ps -o command= -p "$provider_pid" 2>/dev/null || true)"
  [[ "$command_line" == *"_execute-turn $worker_id $turn"* ]]
}

signal_provider_snapshot() {
  local dir="$1"
  local state="$2"
  local signal="$3"
  local generation
  local provider_pid
  local provider_pgid
  local provider_start

  generation="$(snapshot_get "$state" generation)"
  active_generation_matches "$dir" "$generation" || return 1
  provider_identity_matches_snapshot "$dir" "$state" || return 1
  provider_pid="$(snapshot_get "$state" provider_pid)"
  provider_pgid="$(snapshot_get "$state" provider_pgid)"
  provider_start="$(snapshot_get "$state" provider_start)"
  signal_provider_identity "$provider_pid" "$provider_pgid" \
    "$provider_start" "$signal"
}

cmd_api_key() {
  (($# <= 1)) || die "api-key accepts at most one argument"

  local key="${1:-}"
  if [[ -z "$key" ]]; then
    [[ -t 0 ]] || die "api-key requires a key when stdin is not interactive"
    printf 'Z.ai API key: ' >&2
    IFS= read -r -s key
    printf '\n' >&2
  fi
  [[ -n "$key" ]] || die "API key must not be empty"

  ensure_state_home
  local tmp
  tmp="$(mktemp "$GLM_AGENT_HOME/.env.auth.XXXXXX")"
  chmod 600 "$tmp"
  printf '%s' "$key" >"$tmp"
  mv "$tmp" "$AUTH_FILE"
  chmod 600 "$AUTH_FILE"

  printf 'API_KEY=SAVED\n'
  printf 'AUTH_FILE=%s\n' "$AUTH_FILE"
}

cmd_team_scope() {
  if (($# == 0)); then
    load_team_scope
    printf 'TEAM_SCOPE=%s\n' "$ZAI_QUOTA_SCOPE"
    printf 'ORGANIZATION=%s\n' "${ZAI_QUOTA_ORGANIZATION:-}"
    printf 'PROJECT=%s\n' "${ZAI_QUOTA_PROJECT:-}"
    return 0
  fi

  if [[ "$1" == --clear ]]; then
    (($# == 1)) || die "team-scope --clear accepts no other arguments"
    rm -f -- "$TEAM_SCOPE_FILE"
    printf 'TEAM_SCOPE=CLEARED\n'
    return 0
  fi

  (($# == 2)) ||
    die "team-scope requires an organization and a project, --clear, or no arguments"
  local organization="$1" project="$2"
  [[ -n "$organization" ]] || die "team organization must not be empty"
  [[ -n "$project" ]] || die "team project must not be empty"
  validate_single_line "team organization" "$organization"
  validate_single_line "team project" "$project"

  ensure_state_home
  local tmp
  tmp="$(mktemp "$GLM_AGENT_HOME/.team-scope.XXXXXX")" ||
    die "cannot create a temporary file in $GLM_AGENT_HOME"
  chmod 600 "$tmp"
  printf 'organization=%s\nproject=%s\n' "$organization" "$project" >"$tmp"
  mv "$tmp" "$TEAM_SCOPE_FILE"

  printf 'TEAM_SCOPE=SAVED\n'
  printf 'ORGANIZATION=%s\n' "$organization"
  printf 'PROJECT=%s\n' "$project"
}

cmd_run() {
  (($# > 0)) || die "run requires a prompt"
  load_api_key
  local prompt="$*"
  (
    unset GLM_RESULT_FILE
    run_glm_claude -p --model "$CLAUDE_MODEL" "$prompt"
  )
}

cleanup_log() {
  {
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >>"$CLEANUP_LOG_FILE"
    chmod 600 "$CLEANUP_LOG_FILE"
  } 2>/dev/null || true
}

cleanup_worker() {
  local dir="$1"
  local name
  local status
  local mtime
  local idle_days
  local generation

  name="${dir##*/}"
  [[ "$name" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] || return 0
  [[ -f "$dir/meta" ]] || return 0
  status="$(meta_get "$dir" status)"
  case "$status" in
    DONE|BLOCKED|NO_REPORT|INVALID) ;;
    *) return 0 ;;
  esac
  mtime="$(stat -f '%m' "$dir/meta" 2>/dev/null || stat -c '%Y' "$dir/meta" 2>/dev/null || true)"
  [[ "$mtime" =~ ^[0-9]+$ ]] || mtime="$(date +%s)"
  idle_days="$((($(date +%s) - mtime) / 86400))"
  generation="$(new_active_generation)"
  acquire_worker_lock "$dir" "cleanup" "$generation"
  rm -rf -- "$dir"
  cleanup_log "deleted worker=$name status=$status idle_days=$idle_days"
}

cleanup_old_workers() {
  local days="${GLM_WORKER_RETENTION_DAYS:-21}"
  local minutes
  local meta_path

  if [[ "$days" =~ ^[0-9]+$ ]] && ((10#$days == 0)); then
    return 0
  fi
  [[ -d "$WORKERS_DIR" ]] || return 0
  if [[ -n "$(find "$CLEANUP_STAMP_FILE" -mmin -1440 2>/dev/null)" ]]; then
    return 0
  fi
  touch "$CLEANUP_STAMP_FILE"
  chmod 600 "$CLEANUP_STAMP_FILE"
  if [[ ! "$days" =~ ^[0-9]+$ ]]; then
    cleanup_log "warn invalid GLM_WORKER_RETENTION_DAYS=$days"
    return 0
  fi
  minutes="$((10#$days * 1440))"
  while IFS= read -r meta_path; do
    (cleanup_worker "${meta_path%/meta}") 2>/dev/null || true
  done < <(find "$WORKERS_DIR" -mindepth 2 -maxdepth 2 -name meta -mmin "+$minutes" 2>/dev/null)
}

cmd_start() {
  local model="$CLAUDE_MODEL"
  local role="$DEFAULT_ROLE"
  local cwd="$PWD"
  local async=false

  while (($#)); do
    case "$1" in
      --async)
        async=true
        shift
        ;;
      --model)
        (($# >= 2)) || die "--model requires a value"
        model="$2"
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --cwd)
        (($# >= 2)) || die "--cwd requires a value"
        cwd="$2"
        shift 2
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --*)
        die "unknown option for start: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  (($# > 0)) || die "start requires a task"
  local task="$*"

  validate_single_line "model" "$model"
  [[ -n "$model" ]] || die "model must not be empty"
  validate_single_line "role" "$role"
  validate_role "$role"
  [[ -d "$cwd" ]] || die "working directory does not exist: $cwd"
  cwd="$(cd "$cwd" && pwd -P)"
  validate_single_line "working directory" "$cwd"

  require_execution_dependencies
  load_api_key
  require_system_prompt_file
  (cleanup_old_workers) >/dev/null 2>&1 || true
  local worker_id
  worker_id="$(create_worker "$model" "$role" "$cwd" "$task" "")"

  if [[ "$async" == "true" ]]; then
    run_turn_async "$worker_id" "$task"
  else
    run_turn "$worker_id" "$task"
  fi
}

# Opens the User's own interactive Claude Code session. There is no worker,
# no turn bookkeeping, and no worker contract system prompt: the session is
# the main conversation, not a subagent, and must not believe otherwise.
run_tui_session() {
  local mode="$1" session_id="$2" cwd="$3" model="$4" exit_code=0

  if [[ "$mode" == resume ]]; then
    printf 'RESUME=%s\n' "$session_id"
  else
    printf 'SESSION_ID=%s\n' "$session_id"
  fi
  printf 'CWD=%s\n' "$cwd"

  local -a args=(--model "$model" --dangerously-skip-permissions)
  if [[ "$mode" == resume ]]; then
    args+=(--resume "$session_id")
  else
    args+=(--session-id "$session_id")
  fi

  (cd "$cwd" && run_glm_claude "${args[@]}") || exit_code=$?
  printf 'EXIT_CODE=%d\n' "$exit_code"
  return "$exit_code"
}

cmd_tui() {
  local model="$CLAUDE_MODEL"
  local cwd="$PWD"
  local resume_id=""

  while (($#)); do
    case "$1" in
      --model)
        (($# >= 2)) || die "--model requires a value"
        model="$2"
        shift 2
        ;;
      --cwd)
        (($# >= 2)) || die "--cwd requires a value"
        cwd="$2"
        shift 2
        ;;
      --resume)
        (($# >= 2)) || die "--resume requires a Claude session id"
        resume_id="$2"
        shift 2
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --*) die "unknown option for tui: $1" ;;
      *)
        die "tui does not accept positional arguments; resume a session with --resume <session-id>"
        ;;
    esac
  done

  require_execution_dependencies
  load_api_key
  validate_single_line "model" "$model"
  [[ -n "$model" ]] || die "model must not be empty"
  [[ -d "$cwd" ]] || die "working directory does not exist: $cwd"
  cwd="$(cd "$cwd" && pwd -P)"
  validate_single_line "working directory" "$cwd"
  if [[ -n "$resume_id" ]]; then
    validate_single_line "session id" "$resume_id"
    [[ -n "$resume_id" ]] || die "session id must not be empty"
    run_tui_session resume "$resume_id" "$cwd" "$model" || exit $?
    return
  fi

  require_command od
  run_tui_session new "$(new_claude_session_id)" "$cwd" "$model" || exit $?
}

cmd_send() {
  local async=false
  if [[ "${1:-}" == "--async" ]]; then
    async=true
    shift
  fi
  (($# >= 2)) || die "send requires a worker-id and message"

  local worker_id="$1"
  shift
  local message="$*"
  local dir

  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  [[ "$(meta_get "$dir" closed)" != "true" ]] ||
    die "worker is closed: $worker_id"
  [[ -n "$(meta_get "$dir" claude_session_id)" ]] ||
    die "worker has no Claude session: $worker_id"

  if [[ "$async" == "true" ]]; then
    run_turn_async "$worker_id" "$message"
  else
    run_turn "$worker_id" "$message"
  fi
}

cmd_wait() {
  local timeout=20

  while (($#)); do
    case "$1" in
      --timeout)
        (($# >= 2)) || die "--timeout requires a value"
        timeout="$2"
        shift 2
        ;;
      --*) die "unknown option for wait: $1" ;;
      *) break ;;
    esac
  done
  (($# == 1)) || die "wait requires a worker-id"
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "wait timeout must be an integer from 0 to 300"
  ((10#$timeout <= 300)) || die "wait timeout must be an integer from 0 to 300"

  local worker_id="$1"
  local dir
  local status
  local deadline
  local meta
  local observed_turn
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  deadline="$(( $(date +%s) + 10#$timeout ))"

  while :; do
    recover_stale_lock "$dir"
    if load_worker_snapshot "$dir"; then
      meta="$WORKER_META_SNAPSHOT"
      if [[ "$WORKER_HAS_ACTIVE" == "true" ]]; then
        status="RUNNING"
        observed_turn="$(snapshot_get "$WORKER_ACTIVE_SNAPSHOT" turn)"
      else
        status="$(snapshot_get "$meta" status)"
        observed_turn="$(snapshot_get "$meta" turn)"
      fi
      case "$status" in
        DONE|BLOCKED|NO_REPORT|INVALID)
          print_observed_turn "$dir" "$status" "$meta" "$observed_turn"
          printf '%s\n' 'WAIT_RESULT=TERMINAL'
          return 0
          ;;
      esac
    else
      meta=""
      status="UNKNOWN"
      observed_turn=""
    fi
    if (( $(date +%s) >= deadline )); then
      print_observed_turn "$dir" "$status" "$meta" "$observed_turn"
      printf '%s\n' 'WAIT_RESULT=TIMEOUT'
      return 0
    fi
    sleep 0.1
  done
}

cmd_cancel() {
  (($# == 1)) || die "cancel requires a worker-id"

  local worker_id="$1"
  local dir
  local status
  local runner_pid
  local runner_start
  local state
  local generation
  local marker
  local provider_owned=false
  local provider_pgid=""
  local provider_start=""
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"

  load_worker_snapshot "$dir" || die "could not read stable worker state: $worker_id"
  if [[ "$WORKER_HAS_ACTIVE" != "true" ]]; then
    status="$(snapshot_get "$WORKER_META_SNAPSHOT" status)"
    case "$status" in
      DONE|BLOCKED|NO_REPORT|INVALID)
        print_observed_turn "$dir" "$status" "$WORKER_META_SNAPSHOT"
        printf '%s\n' 'CANCEL_RESULT=ALREADY_TERMINAL'
        return 0
        ;;
      *) die "worker has no active asynchronous turn: $worker_id" ;;
    esac
  fi

  state="$WORKER_ACTIVE_SNAPSHOT"
  generation="$(snapshot_get "$state" generation)"
  [[ "$(snapshot_get "$state" mode)" == "headless" &&
     "$(snapshot_get "$state" supervision)" == "async" ]] ||
    die "worker is not running an asynchronous headless turn: $worker_id"
  runner_identity_matches_snapshot "$dir" "$state" ||
    die "active runner identity is invalid: $worker_id"

  marker="$dir/cancel.$generation.requested"
  : >"$marker"
  chmod 600 "$marker"
  if active_generation_matches "$dir" "$generation"; then
    if signal_provider_snapshot "$dir" "$state" TERM; then
      provider_owned=true
      provider_pgid="$(snapshot_get "$state" provider_pgid)"
      provider_start="$(snapshot_get "$state" provider_start)"
    fi
  fi

  for _ in {1..50}; do
    active_generation_matches "$dir" "$generation" || break
    if ! runner_identity_matches_snapshot "$dir" "$state"; then
      if [[ "$provider_owned" == "true" ]]; then
        drain_owned_provider_group "$provider_pgid" "$provider_start" || true
      fi
      finalize_interrupted_turn "$dir" "$generation"
      break
    fi
    sleep 0.1
  done

  if active_generation_matches "$dir" "$generation"; then
    runner_pid="$(snapshot_get "$state" runner_pid)"
    runner_start="$(snapshot_get "$state" runner_start)"
    if runner_identity_matches_snapshot "$dir" "$state"; then
      kill -TERM "$runner_pid" 2>/dev/null || true
    fi
    for _ in {1..10}; do
      active_generation_matches "$dir" "$generation" || break
      process_matches_start "$runner_pid" "$runner_start" || break
      sleep 0.1
    done
  fi

  if active_generation_matches "$dir" "$generation"; then
    load_worker_snapshot "$dir" || die "could not read stable worker state: $worker_id"
    if [[ "$WORKER_HAS_ACTIVE" != "true" ||
       "$(snapshot_get "$WORKER_ACTIVE_SNAPSHOT" generation)" != "$generation" ]]; then
      state=""
    else
      state="$WORKER_ACTIVE_SNAPSHOT"
    fi
  fi

  if [[ -n "$state" ]] && active_generation_matches "$dir" "$generation"; then
    signal_provider_snapshot "$dir" "$state" KILL || true
    runner_pid="$(snapshot_get "$state" runner_pid)"
    runner_start="$(snapshot_get "$state" runner_start)"
    if runner_identity_matches_snapshot "$dir" "$state"; then
      kill -KILL "$runner_pid" 2>/dev/null || true
    fi
    for _ in {1..10}; do
      process_matches_start "$runner_pid" "$runner_start" || break
      sleep 0.1
    done
    if process_matches_start "$runner_pid" "$runner_start"; then
      die "failed to stop active runner: $worker_id"
    fi
    if [[ "$provider_owned" == "true" ]]; then
      drain_owned_provider_group "$provider_pgid" "$provider_start" || true
    fi
    finalize_interrupted_turn "$dir" "$generation"
  fi

  # Our own finalize attempt above may have been skipped or lost the claim
  # race (another finalizer already handled this exact generation, or a
  # replacement turn has already started). Give whichever party is actually
  # finishing this generation a bounded chance to settle before reporting.
  for _ in {1..20}; do
    active_generation_matches "$dir" "$generation" || break
    sleep 0.1
  done

  load_worker_snapshot "$dir" || die "could not read stable worker state: $worker_id"
  if [[ "$WORKER_HAS_ACTIVE" == "true" ]]; then
    # Either this generation is still active (an unusually slow finalizer
    # elsewhere) or a replacement generation has already started. Either
    # way we cannot truthfully report a terminal CANCELLED result, and must
    # never pair STATUS=RUNNING with CANCEL_RESULT=CANCELLED.
    print_observed_turn "$dir" "RUNNING" "$WORKER_META_SNAPSHOT"
    printf '%s\n' 'CANCEL_RESULT=PENDING'
    return 0
  fi
  status="$(snapshot_get "$WORKER_META_SNAPSHOT" status)"
  print_observed_turn "$dir" "$status" "$WORKER_META_SNAPSHOT"
  printf '%s\n' 'CANCEL_RESULT=CANCELLED'
}

cmd_result() {
  (($# == 1)) || die "result requires a worker-id"

  local worker_id="$1"
  local dir
  local result
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  result="$(meta_get "$dir" latest_result)"
  [[ -n "$result" && -f "$result" ]] ||
    die "worker has no valid result: $worker_id"
  printf '%s\n' "$result"
}

cmd_status() {
  (($# == 1)) || die "status requires a worker-id"

  local worker_id="$1"
  local dir
  local meta
  local active=""
  local status
  local active_turn
  local active_mode
  local turn
  local error_kind
  local provider_code
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"
  load_worker_snapshot "$dir" || die "could not read stable worker state: $worker_id"
  meta="$WORKER_META_SNAPSHOT"
  active="$WORKER_ACTIVE_SNAPSHOT"
  if [[ "$WORKER_HAS_ACTIVE" == "true" ]]; then
    status="RUNNING"
    active_mode="$(snapshot_get "$active" mode)"
    active_turn="$(snapshot_get "$active" turn)"
    turn="$active_turn"
    error_kind=""
    provider_code=""
  else
    status="$(snapshot_get "$meta" status)"
    active_mode=""
    active_turn=""
    turn="$(snapshot_get "$meta" turn)"
    error_kind="$(snapshot_get "$meta" error_kind)"
    provider_code="$(snapshot_get "$meta" provider_code)"
  fi

  printf 'WORKER_ID=%s\n' "$worker_id"
  printf 'STATUS=%s\n' "$status"
  printf 'TURN=%s\n' "$turn"
  printf 'MODEL=%s\n' "$(snapshot_get "$meta" model)"
  printf 'ROLE=%s\n' "$(snapshot_get "$meta" role)"
  printf 'CWD=%s\n' "$(snapshot_get "$meta" cwd)"
  printf 'CLOSED=%s\n' "$(snapshot_get "$meta" closed)"
  printf 'RESULT=%s\n' "$(snapshot_get "$meta" latest_result)"
  printf 'ERROR_KIND=%s\n' "$error_kind"
  printf 'PROVIDER_CODE=%s\n' "$provider_code"
  print_no_report_fields "$status" "$meta"
  if [[ "$error_kind" == "quota-exhausted" ]]; then
    printf '%s\n' 'FALLBACK_RECOMMENDED=true'
  else
    printf '%s\n' 'FALLBACK_RECOMMENDED=false'
  fi
  printf 'ACTIVE_MODE=%s\n' "$active_mode"
  printf 'ACTIVE_TURN=%s\n' "$active_turn"
}

cmd_list() {
  (($# == 0)) || die "list accepts no arguments"
  [[ -d "$WORKERS_DIR" ]] || return 0

  local dir
  for dir in "$WORKERS_DIR"/*; do
    [[ -f "$dir/meta" ]] || continue
    printf 'WORKER_ID=%s\tSTATUS=%s\tTURN=%s\tROLE=%s\tCLOSED=%s\tCWD=%s\n' \
      "$(meta_get "$dir" worker_id)" \
      "$(meta_get "$dir" status)" \
      "$(meta_get "$dir" turn)" \
      "$(meta_get "$dir" role)" \
      "$(meta_get "$dir" closed)" \
      "$(meta_get "$dir" cwd)"
  done
}

cmd_close() {
  (($# == 1)) || die "close requires a worker-id"

  local worker_id="$1"
  local dir
  local generation
  require_worker "$worker_id"
  dir="$(worker_dir "$worker_id")"
  recover_stale_lock "$dir"
  generation="$(new_active_generation)"
  acquire_worker_lock "$dir" "close" "$generation"
  meta_set "$dir" closed "true"
  release_worker_lock "$dir" "$generation"

  printf 'WORKER_ID=%s\n' "$worker_id"
  printf 'CLOSED=true\n'
}

QUOTA_ENDPOINT_PATH='/api/monitor/usage/quota/limit'

# jq program for a successful quota response. It prints the KEY=VALUE lines
# after the two status lines the wrapper prints itself; missing numbers print
# empty and server strings lose control characters.
quota_render_jq() {
  cat <<'JQ'
def str:
  if type == "string" then gsub("[[:cntrl:]]"; " ")
  elif type == "number" or type == "boolean" then tostring
  else "" end;
def num: if type == "number" then tostring else "" end;
def window:
  if (.unit | type) == "number" and (.number | type) == "number" then
    if .unit == 3 then "\(.number)h"
    elif .unit == 6 then "\(.number)w"
    else "u\(.unit)x\(.number)" end
  else "" end;
def reset_at:
  if (.nextResetTime | type) == "number"
  then (try (.nextResetTime / 1000 | floor | todate) catch "")
  else "" end;
.data as $data
| ($data.limits | length) as $count
| "PLAN_LEVEL=\($data.level | str)",
  "LIMIT_COUNT=\($count)",
  (range(0; $count) as $i
    | ($i + 1) as $n
    | ($data.limits[$i] | if type == "object" then . else {} end) as $limit
    | "LIMIT_\($n)_TYPE=\($limit.type | str)",
      "LIMIT_\($n)_WINDOW=\($limit | window)",
      "LIMIT_\($n)_TOTAL=\($limit.usage | num)",
      "LIMIT_\($n)_USED=\($limit.currentValue | num)",
      "LIMIT_\($n)_REMAINING=\($limit.remaining | num)",
      "LIMIT_\($n)_USED_PERCENT=\($limit.percentage | num)",
      "LIMIT_\($n)_RESET_AT=\($limit | reset_at)")
JQ
}

quota_endpoint_url() {
  local base_pattern='^(https?://[A-Za-z0-9.-]+(:[0-9]+)?)(/|$)'

  [[ "$ZAI_BASE_URL" =~ $base_pattern ]] ||
    die "ZAI_BASE_URL must look like http(s)://host[:port][/path]"
  printf '%s%s\n' "${BASH_REMATCH[1]}" "$QUOTA_ENDPOINT_PATH"
}

# Temp files of the lookup in flight; the traps below remove them.
QUOTA_RESPONSE_TMP=""
QUOTA_STDERR_TMP=""

quota_cleanup() {
  [[ -z "$QUOTA_RESPONSE_TMP" ]] || rm -f -- "$QUOTA_RESPONSE_TMP"
  [[ -z "$QUOTA_STDERR_TMP" ]] || rm -f -- "$QUOTA_STDERR_TMP"
}

quota_signal_exit() {
  trap - INT TERM EXIT
  quota_cleanup
  exit "$1"
}

# Every state-directory failure must end as a setup error (exit 2); a bare
# mkdir or chmod failure would exit 1 without a QUOTA_STATUS line.
quota_private_dir() {
  mkdir -p "$1" || die "cannot create directory: $1"
  chmod 700 "$1" || die "cannot set directory permissions: $1"
}

# An HTTP status row names a default kind. A body code that classify_error_kind
# recognises overrides it; an unrecognised or missing code keeps the default.
quota_http_error_kind() {
  local kind
  kind="$(classify_error_kind "$1" "$2")"
  if [[ "$kind" == provider-error ]]; then
    kind="$2"
  fi
  printf '%s\n' "$kind"
}

cmd_quota() {
  (($# == 0)) || die "quota does not accept arguments"
  require_command curl
  require_command jq

  local url
  url="$(quota_endpoint_url)"
  load_api_key
  validate_single_line "API key" "$API_KEY"
  load_team_scope

  # A team scope switches the lookup to the team plan: the request gains
  # type=2 and both Bigmodel selector headers join the key in curl's stdin
  # header block, so no selector reaches a process argument list either.
  local header_block
  if [[ "$ZAI_QUOTA_SCOPE" == team ]]; then
    url="$url?type=2"
    header_block="Authorization: $API_KEY
Bigmodel-Organization: $ZAI_QUOTA_ORGANIZATION
Bigmodel-Project: $ZAI_QUOTA_PROJECT"
  else
    header_block="Authorization: $API_KEY"
  fi

  local quota_dir="$GLM_AGENT_HOME/quota"
  local response_file="$quota_dir/response.json"
  local stderr_file="$quota_dir/stderr.log"
  quota_private_dir "$GLM_AGENT_HOME"
  quota_private_dir "$quota_dir"

  trap quota_cleanup EXIT
  trap 'quota_signal_exit 130' INT
  trap 'quota_signal_exit 143' TERM
  local response_tmp stderr_tmp
  response_tmp="$(mktemp "$quota_dir/.response.XXXXXX")" ||
    die "cannot create a temporary file in $quota_dir"
  QUOTA_RESPONSE_TMP="$response_tmp"
  stderr_tmp="$(mktemp "$quota_dir/.stderr.XXXXXX")" ||
    die "cannot create a temporary file in $quota_dir"
  QUOTA_STDERR_TMP="$stderr_tmp"

  # The key travels only as a header line on curl's stdin (printf is a shell
  # builtin), so it never appears in any process argument list. -q must come
  # first: it keeps a user's curlrc (verbose, fail, ...) from changing the call.
  local http_code curl_status=0
  http_code="$(
    printf '%s\n' "$header_block" |
      curl -q -sS --connect-timeout 5 --max-time 10 \
        -H @- -H 'Accept-Language: en-US,en' \
        -o "$response_tmp" -w '%{http_code}' "$url" 2>"$stderr_tmp"
  )" || curl_status=$?

  case "$http_code" in
    [0-9][0-9][0-9]) ;;
    *) http_code=000 ;;
  esac

  # A body counts as JSON only when it is exactly one object; trailing
  # garbage, a second document, or an empty body all fail the check.
  local body_ok=0 api_ok="" limits_kind="" provider_code=""
  local fields
  if jq -e -s 'length == 1 and (.[0] | type) == "object"' \
    "$response_tmp" >/dev/null 2>&1 &&
    fields="$(jq -r '
      (if (.code | type) == "number" and .code != 200
        then (.code | tostring) else "" end),
      (if .code == 200 and .success == true then "true" else "false" end),
      ((((.data | objects | .limits) // null) | type)
        | if . == "array" then "array" else "other" end)
    ' "$response_tmp")"; then
    body_ok=1
    {
      IFS= read -r provider_code
      IFS= read -r api_ok
      IFS= read -r limits_kind
    } <<<"$fields"
  fi

  # Each branch is one row of the ERROR_KIND table; the first match wins. The
  # HTTP 401/403 and 429/5xx rows still defer to a recognised body code.
  local error_kind=""
  if ((curl_status != 0)); then
    error_kind='provider-transient'
  elif [[ "$http_code" == 401 || "$http_code" == 403 ]]; then
    error_kind="$(quota_http_error_kind "$provider_code" authentication)"
  elif [[ "$http_code" == 429 || "$http_code" == 5?? ]]; then
    error_kind="$(quota_http_error_kind "$provider_code" provider-transient)"
  elif ((body_ok == 1)) && [[ "$api_ok" != true ]]; then
    error_kind="$(classify_error_kind "$provider_code" provider-error)"
  elif [[ "$http_code" == 200 ]] &&
    { ((body_ok == 0)) || [[ "$limits_kind" != array ]]; }; then
    error_kind='invalid-response'
  elif [[ "$http_code" != 200 ]]; then
    error_kind='provider-error'
  fi

  local rendered=""
  if [[ -z "$error_kind" ]] &&
    ! rendered="$(jq -r "$(quota_render_jq)" "$response_tmp")"; then
    error_kind='invalid-response'
  fi

  mv -f "$response_tmp" "$response_file" ||
    die "cannot store the quota response: $response_file"
  mv -f "$stderr_tmp" "$stderr_file" ||
    die "cannot store the curl stderr: $stderr_file"

  if [[ -n "$error_kind" ]]; then
    printf 'QUOTA_STATUS=INVALID\n'
    printf 'SCOPE=%s\n' "$ZAI_QUOTA_SCOPE"
    printf 'RESPONSE=%s\n' "$response_file"
    printf 'ERROR_KIND=%s\n' "$error_kind"
    printf 'PROVIDER_CODE=%s\n' "$provider_code"
    return 1
  fi

  printf 'QUOTA_STATUS=OK\n'
  printf 'SCOPE=%s\n' "$ZAI_QUOTA_SCOPE"
  printf '%s\n' "$rendered"
  printf 'RESPONSE=%s\n' "$response_file"
  printf 'ERROR_KIND=\n'
  printf 'PROVIDER_CODE=\n'
}

main() {
  local command="${1:-}"

  case "$command" in
    --help|-h|help|"")
      usage
      ;;
    --version|version)
      printf '%s %s\n' "$PROGRAM" "$VERSION"
      ;;
    api-key)
      shift
      cmd_api_key "$@"
      ;;
    team-scope)
      shift
      cmd_team_scope "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    send)
      shift
      cmd_send "$@"
      ;;
    tui)
      shift
      cmd_tui "$@"
      ;;
    wait)
      shift
      cmd_wait "$@"
      ;;
    cancel)
      shift
      cmd_cancel "$@"
      ;;
    result)
      shift
      cmd_result "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    close)
      shift
      cmd_close "$@"
      ;;
    quota)
      shift
      cmd_quota "$@"
      ;;
    _execute-turn)
      shift
      cmd_execute_turn "$@"
      ;;
    *)
      die "unknown command: $command (try '$PROGRAM --help')"
      ;;
  esac
}

main "$@"
